{
  "name": "contracts-library",
  "version": "0.0.0",
  "private": true,
  "description": "Standardized, reusable smart contracts for Cardano",
  "license": "Apache-2.0",
  "scripts": {
    "catalogue:check": "node scripts/check-catalogue.mjs",
    "catalogue:test": "node --test test/check-catalogue.test.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "ajv": "8.20.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json}": "biome format --write --no-errors-on-unmatched",
    "*.ak": "bash scripts/aiken-fmt.sh"
  }
}
