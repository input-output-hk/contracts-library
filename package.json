{
  "name": "contracts-library",
  "version": "0.0.0",
  "private": true,
  "description": "Standardized, reusable smart contracts for Cardano",
  "license": "Apache-2.0",
  "scripts": {
    "format": "biome format --write . && prettier --write .",
    "format:check": "biome format . && prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json}": "biome format --write --no-errors-on-unmatched",
    "website/**/*.{astro,mdx}": "prettier --write --ignore-unknown",
    "*.ak": "bash scripts/aiken-fmt.sh"
  }
}
