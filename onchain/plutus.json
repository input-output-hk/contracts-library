    "vesting/types/VestingDatum": {
      "title": "VestingDatum",
      "description": "Immutable vesting state. Written once at lock time; every continuing output\n must reproduce it verbatim. Times are POSIX **milliseconds**.",
      "anyOf": [
        {
          "title": "VestingDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "beneficiary",
