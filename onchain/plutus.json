              "$ref": "#/definitions/cardano~1address~1Credential"
            },
            {
              "title": "locker",
              "description": "Who may recover the remainder after `recovery_time`. Same pluggable\n credential mechanism as `beneficiary`.",
              "$ref": "#/definitions/cardano~1address~1Credential"
            },
            {
              "title": "vesting",
