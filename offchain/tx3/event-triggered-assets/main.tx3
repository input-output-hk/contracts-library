// Event-triggered assets — tokenized bond (Tx3 off-chain).
//
// Reference Tx3 implementation of the event-triggered assets CIP-113
// substandard (issue #28), mirroring the on-chain withdraw-zero validators in
// `onchain/validators/event_triggered_assets.ak` and
// `onchain/lib/event_triggered/`. The normative spec is
// `docs/event-triggered-assets/spec.md`; these templates follow the flows of
// `docs/event-triggered-assets/design.typ` (T0/T1, T2, T2b, T3, T4) in full,
// including the CIP-113 core chains.
//
// The instrument ships four withdraw-zero validators — the substandard's
// issuance (minting) logic, transfer logic and third-party logic, plus a
// smart-wallet transformation script — and the graduated asset's native mint
// policy. There is deliberately no spend or mint endpoint of our own: the
// shared Programmable Logic Base custodies the token UTxOs, and every PLB
// spend runs the core dispatch chain
//
//   programmable_logic_global [TransferAct | ThirdPartyAct]
//     -> transfer | third_party [TransferRedeemer | ThirdPartyRedeemer]
//     -> transfer_logic | third_party_logic (ours)
//
// exactly as the design figures show. Every chain leg carries the vendored
// core's redeemer encoding: `ProgrammableLogicGlobalRedeemer` selects the
// dispatcher arm, the core `transfer` / `third_party` redeemers carry the
// registry-node indices, the registry mint carries `RegistryInsert`, the core
// issuance logic carries the per-policy `MintingRegistryProof` map, and
// `issuance_mint` the protocol-params index. The applied core scripts and the
// bond's module scripts travel through the environment (tx3 cannot apply
// parameters); the TEST KIT section at the bottom deploys the core with the
// same scripts.
//
// Script-material convention: tx3 hashes the exact bytes it is handed as a
// witness (`blake2b224(0x03 || bytes)`) and the Plutus evaluator CBOR-decodes
// those bytes, so every `*_script` value is the script's single-CBOR
// "payload" form. The off-chain helpers that compute them (the vendored e2e
// core helpers and the library's `applyParamsToScript`) are normalized to
// that form — see `tests/cip113.ts`.
//
// Every PLB input carries `BaseSpendRedeemer { params_idx, wdrl_idx }` — one
// record per PLB input, no action arm; the path is selected by the
// dispatcher's redeemer, never by the base redeemer (design T2 notes).
// `params_idx` locates the protocol-params reference input; `wdrl_idx` is
// derived from the canonical sorted withdrawal set (scripts before vkeys,
// ascending — 09-DEVELOPING-MODULES §10). Both are caller-supplied.
//
// The schedule is baked as validator constants (spec §3.5); values derived
// from it are computed off-chain and passed as parameters:
//
//   - transformation: `next_value = lookup(schedule, now)` with the validity
//     lower bound in `d1 <= now <= d4` (§4.4, §5);
//   - graduation: `native_quantity = Σ floor(Q × v4 / scale)` over the burned
//     owners' whole holdings, with the validity lower bound at `d4` or later
//     (§4.5); `quantity` must cover the holder's whole holding per name. Both
//     paths carry the reference token as a reference input: the burn reads the
//     graduated asset's policy (`extra.native_policy`) from its datum (§3.3).
//
// Authorization (key-authorized paths only — Tx3 has no runtime key-vs-script
// branch): the issuer signs the registration (§4.1); the sender signs the
// free transfer and the owner signs the payout-key self-transfer (§4.2, §4.3
// — owner-signed, per the design figures); the graduation's owner path is
// signed — the signature names and authorizes the payout destination
// (Q-GRAD-2) — while the third-party path carries no signature and requires
// the owner's pre-committed payment credential (§4.3) in the token datum,
// which the template enforces by typing the spent input's datum. The
// transformation is permissionless: no signature, only the fee payer (§4.4).
//
// The transactions:
//
//   register_issue         atomic register + first issue (T0/T1, §4.1)
//   transfer               free transfer (T2, §4.2)
//   register_payout_key    payout-key self-transfer (T2b, §4.3)
//   transform              scheduled transformation (T3, §4.4)
//   graduate_owner         deadline graduation, owner-signed (T4, §4.5)
//   graduate_third_party   deadline graduation, permissionless + ghost (§4.5)

env {
    /// The governed policy id — hash of the `issuance_mint` script
    /// parameterized by this instrument's minting-logic credential.
    cip_policy: Bytes,
    /// The applied `issuance_mint` minting policy (single-CBOR payload).
    cip_policy_script: Bytes,
    /// Policy id of the core registry's node-NFT policy (the registry mint
    /// handler).
    node_policy: Bytes,
    /// The applied registry node-NFT minting policy (single-CBOR payload).
    node_policy_script: Bytes,
    /// Policy id of the graduated asset's native mint policy (§4.5).
    native_policy: Bytes,
    /// The applied native mint policy (single-CBOR payload).
    native_mint_script: Bytes,
    /// The applied PLB base spend script guarding the token UTxOs
    /// (single-CBOR payload); the spend redeemer is the `BaseSpendRedeemer`.
    plb_script: Bytes,
    /// The protocol-params reference input every transaction carries (the
    /// design's "Protocol params").
    protocol_params_ref: UtxoRef,
    /// The principal asset name (hex) — the only name a graduation may burn.
    principal_name: Bytes,
    /// The CIP-68 reference asset name (hex; a `222` label, §3.3).
    reference_name: Bytes,
    /// UTxO carrying the PLB global (dispatcher) stake script as a reference
    /// script; its withdraw-0 carries the `TransferAct` / `ThirdPartyAct`.
    plb_global_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the PLB global's withdraw-0.
    plb_global_script_address: Bytes,
    /// UTxO carrying the core `transfer` stake script as a reference script;
    /// its withdraw-0 dispatches the transfer path.
    core_transfer_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the core `transfer` withdraw-0.
    core_transfer_script_address: Bytes,
    /// UTxO carrying the core `third_party` stake script as a reference
    /// script; its withdraw-0 dispatches the third-party path.
    core_third_party_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the core `third_party` withdraw-0.
    core_third_party_script_address: Bytes,
    /// UTxO carrying the core `issuance_logic` stake script as a reference
    /// script; its withdraw-0 proves the names policy + OutputIndex on every
    /// mint/burn under the governed policy.
    core_issuance_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the core issuance logic's withdraw-0.
    core_issuance_script_address: Bytes,
    /// UTxO carrying the issuance (minting) logic as a reference script; its
    /// withdraw-0 carries the `RegisterAndMint` / `Burn` mode (§4.1, §4.5).
    issuance_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the issuance logic's withdraw-0.
    issuance_script_address: Bytes,
    /// UTxO carrying the permissive transfer logic as a reference script.
    transfer_logic_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the transfer logic's withdraw-0.
    transfer_logic_script_address: Bytes,
    /// UTxO carrying the graduation-only third-party logic as a reference
    /// script.
    third_party_logic_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the third-party logic's withdraw-0.
    third_party_logic_script_address: Bytes,
    /// UTxO carrying the transformation script as a reference script.
    transformation_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the transformation script's withdraw-0.
    transformation_script_address: Bytes,
    /// Script hash of the issuance (minting) logic — the credential the
    /// registry node pins as `minting_logic_script` and the `RegistryInsert`
    /// redeemer carries.
    issuance_hash: Bytes,
    /// Policy id of the core `issuance_cbor_hex_mint` (the template reference
    /// NFT policy); TEST KIT bootstrap only.
    cbor_hex_policy: Bytes,
    /// The applied `issuance_cbor_hex_mint` policy script; TEST KIT only.
    cbor_hex_script: Bytes,
    /// UTxO holding the `IssuanceCborHex` template reference NFT (the always-
    /// fail lock). The registry's insert proof derives the governed policy
    /// from it, so every `register_issue` carries it as a reference input.
    cbor_hex_ref: UtxoRef,
    /// Policy id of the core `upgrade_multisig` config policy; TEST KIT only.
    upgrade_multisig_policy: Bytes,
    /// The applied `upgrade_multisig` script; TEST KIT only.
    upgrade_multisig_script: Bytes,
    /// UTxO carrying the applied `upgrade_multisig` script as a reference
    /// script (its withdraw-0 runs from here); TEST KIT only.
    upgrade_multisig_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the upgrade multisig's withdraw-0.
    upgrade_multisig_stake_address: Bytes,
    /// Policy id of the core `protocol_params` NFT policy; TEST KIT only.
    params_policy: Bytes,
    /// The applied `protocol_params` script; TEST KIT only.
    params_script: Bytes,
}

/// The transacting key holder: the issuer (registration), the sender / token
/// owner (transfers, payout key, owner-path graduation), or the fee-paying
/// submitter (transformation, third-party graduation — no signature).
party Signer;

// ------------------------------------------------------------------- policies

// The PLB global (dispatcher) withdraw-0 — the first leg of every PLB spend
// chain; its `ProgrammableLogicGlobalRedeemer` (`TransferAct` /
// `ThirdPartyAct`) selects the path.
policy PlbGlobal {
    ref: plb_global_script_ref,
    hash: plb_global_script_address,
}

// The core `transfer` stake validator withdraw-0 — the dispatch's second leg
// on the transfer path. Its `CoreTransferRedeemer` carries one
// `TokenExists { node_idx }` proof per distinct spent policy.
policy CoreTransfer {
    ref: core_transfer_script_ref,
    hash: core_transfer_script_address,
}

// The core `third_party` stake validator withdraw-0 — the dispatch's second
// leg on the third-party path. Its `CoreThirdPartyRedeemer` names the
// subject policy's registry node and the first paired continuation output.
policy CoreThirdParty {
    ref: core_third_party_script_ref,
    hash: core_third_party_script_address,
}

// The core issuance logic withdraw-0 — proves the names policy and its
// registry proof on every mint/burn under the governed policy (design T0/T1,
// T4). Its redeemer is the `IssuanceLogicRedeemer` map (see the types below).
policy CoreIssuanceLogic {
    ref: core_issuance_script_ref,
    hash: core_issuance_script_address,
}

// The issuance (minting) logic withdraw-0, carrying the `RegisterAndMint` /
// `Burn` mode redeemer. Tx3 does not attach a script witness to a withdrawal
// keyed by an inline script, so the script travels as a reference input (the
// settings-contract pattern); the `ref` UTxO supplies it.
policy IssuanceScript {
    ref: issuance_script_ref,
    hash: issuance_script_address,
}

// The permissive transfer logic withdraw-0 (§4.2).
policy TransferLogic {
    ref: transfer_logic_script_ref,
    hash: transfer_logic_script_address,
}

// The graduation-only third-party logic withdraw-0 (§4.5).
policy ThirdPartyLogic {
    ref: third_party_logic_script_ref,
    hash: third_party_logic_script_address,
}

// The transformation script withdraw-0 (§4.4) — the reference token's stake
// credential and the in-place update's time gate.
policy TransformationScript {
    ref: transformation_script_ref,
    hash: transformation_script_address,
}

// TEST KIT bootstrap only: the upgrade authority's withdraw-0. The script
// travels as a reference script (the resolver has no ref for it before the
// core is up, so the test publishes it between the config and params genesis).
policy UpgradeMultisig {
    ref: upgrade_multisig_script_ref,
    hash: upgrade_multisig_stake_address,
}

// ---------------------------------------------------------------------- types

// `Credential` in the Aiken sense: constructor 0 is a key credential,
// constructor 1 a script credential. The carried value is a Blake2b-224 hash.
type Credential {
    Key {
        hash: Bytes,
    },
    Script {
        hash: Bytes,
    },
}

// `Option<Credential>` — `Some` is constructor 0, `None` constructor 1.
type OptionalCredential {
    Some {
        credential: Credential,
    },
    None,
}

// One step of the baked schedule (§3.5): at `deadline` (POSIX ms) the value
// steps to `value`, in fixed-point `scale` units. Encodes as
// `Constr 0 [deadline, value]`.
type ScheduleStep {
    deadline: Int,
    value: Int,
}

// `extra` of the CIP-68 reference datum (§3.3): the baked schedule, mirrored
// for wallets and indexers, the currently recorded value, and the graduated
// asset's policy id. The published terms are frozen at registration and
// preserved by every later update; the graduation's burn reads `native_policy`
// from the referenced reference token (`issuance.ak`, `published_native_policy`).
type BondExtra {
    schedule: List<ScheduleStep>,
    value: Int,
    native_policy: Bytes,
}

// Inline datum of the reference token (CIP-68 `222`, §3.3). `metadata` is the
// opaque `Bytes` mirror of the on-chain `Data`.
type ReferenceDatum {
    metadata: Bytes,
    version: Int,
    extra: BondExtra,
}

// Inline datum of the principal token (§3.2): normally absent; after §4.3
// optionally the owner's pre-committed payout payment credential.
type PrincipalDatum {
    payment_credential: OptionalCredential,
}

// The core registry's node datum (§3.4), field order per
// `onchain/lib/event_triggered/types.ak` (positional CBOR encoding). The
// unfracking hook uses the `empty_vkey` convention — `VerificationKey(#"")`,
// which forbids unfracking — so its type is `Credential`, not an optional.
type RegistryNode {
    key: Bytes,
    next: Bytes,
    minting_logic_script: Credential,
    transfer_logic_script: Credential,
    third_party_logic_script: Credential,
    unfracking_logic_script: Credential,
    global_state_cs: Bytes,
}

// The PLB base spend redeemer: one record per PLB input in the transaction;
// it carries *no action arm* — the path is selected by the dispatcher's
// redeemer (design T2 notes). `params_idx` locates the protocol-params
// reference input; `wdrl_idx` is the chain's index in the canonical sorted
// withdrawal set (09-DEVELOPING-SUBSTANDARDS §10).
type BaseSpendRedeemer {
    params_idx: Int,
    wdrl_idx: Int,
}

// Mode redeemer of the minting-logic withdraw-0 (§4.1, §4.5): the atomic
// register + first issue, and the graduation's burn. Encodes as
// `Constr 0 []` / `Constr 1 []`.
type MintingAction {
    RegisterAndMint,
    Burn,
}

// Redeemer of the transfer-logic withdraw-0 — permissive, no rules (§4.2).
type TransferAction {
    Move,
}

// Redeemer of the third-party logic withdraw-0 (§4.5): the permissionless
// graduation gate.
type ThirdPartyAction {
    Graduate,
}

// Redeemer of the transformation-script withdraw-0 (§4.4).
type TransformationAction {
    Update,
}

// ----------------------------------------------------------------- core types

// `RegistryProof` (core `lib/types.ak`): a direct index into `reference_inputs`
// proving membership (`TokenExists`) or, via a covering node,
// non-membership (`TokenDoesNotExist`). Constructor order matters.
type RegistryProof {
    TokenExists {
        node_idx: Int,
    },
    TokenDoesNotExist {
        node_idx: Int,
    },
}

// The core `registry` redeemer: `RegistryInit` mints the origin node;
// `RegistryInsert` mints a token's node and pins the issuance credential.
type RegistryRedeemer {
    RegistryInit,
    RegistryInsert {
        key: Bytes,
        minting_logic_script: Credential,
    },
}

// Redeemer of the core `transfer` withdraw-0: one registry proof per distinct
// spent policy, in ascending policy order.
type CoreTransferRedeemer {
    proofs: List<RegistryProof>,
}

// Redeemer of the core `programmable_logic_global` dispatcher: only the arms
// this instrument uses (the core also has `UnfrackingAct`).
type ProgrammableLogicGlobalRedeemer {
    TransferAct,
    ThirdPartyAct,
}

// Redeemer of the core `third_party` withdraw-0: the subject policy's registry
// node index in the reference inputs, and the first output paired with the
// processed PLB inputs.
type CoreThirdPartyRedeemer {
    registry_node_idx: Int,
    outputs_start_idx: Int,
}

// Redeemer of the core `issuance_mint` policy: the protocol-params index in
// the reference inputs.
type IssuanceMintRedeemer {
    params_idx: Int,
}

// `MintingRegistryProof` (core `lib/types.ak`): `OutputIndex` points at a
// registry node created in this transaction (first mint); `RefInput` points at
// a referenced node (already registered). Constructor order matters.
type MintingRegistryProof {
    RefInput {
        index: Int,
    },
    OutputIndex {
        index: Int,
    },
}

// The core `issuance_logic` withdraw-0 redeemer: a Plutus MAP keyed by the
// governed policy, one proof per policy issued (minted or burned) in this
// transaction.
type IssuanceLogicRedeemer = Map<Bytes, MintingRegistryProof>;

// --------------------------------------------------------- bootstrap types

// `IssuanceCborHex` reference datum (core `lib/types.ak`): the `issuance_mint`
// template split around the minting-logic script hash.
type IssuanceCborHex {
    prefix_cbor_hex: Bytes,
    postfix_cbor_hex: Bytes,
}

// The upgrade authority's approval tree (core `lib/multisig.ak`). The test
// bootstrap only ever deploys a single-signature tree, so the recursive cases
// are not carried here.
type UpgradeMultisigDatum {
    Signature {
        key_hash: Bytes,
    },
}

// The core `ProtocolParams` datum (field order per `programmable_logic/params`).
type ProtocolParamsDatum {
    programmable_logic_global_cred: Credential,
    issuance_logic_cred: Credential,
    transfer_cred: Credential,
    third_party_cred: Credential,
    upgrade_cred: Credential,
    pending_upgrade_cred: OptionalCredential,
}

// ------------------------------------------------------------------- register

// Atomic register + first issue (T0/T1, §4.1): create the RegistryNode and
// mint the first batch — principal × `quantity` plus the CIP-68 reference
// token × 1, the only two names under the governed policy. The principal
// lands at the beneficiary's PLB-custodied address; the reference token at
// the transformation script's stake. The covering registry node is spent and
// re-emitted with `next` pointing at the new node (core registry linked
// list). The initial reference datum must mirror the baked schedule at par
// (`version: 1`, `value: scale`) and publish the graduated asset's policy
// (`extra.native_policy` = `native_policy`) — the on-chain registration checks
// the former and every later update preserves the latter. Withdraw-0s: ours
// (`RegisterAndMint`) plus the core issuance proof. The issuer signs.
tx register_issue(
    /// Quantity of principal tokens to mint (N >= 1; the on-chain first-batch
    /// check requires exactly two names, the reference exactly 1).
    quantity: Int,
    /// The registry node datum: `key` = `cip_policy`, the logic fields pinned
    /// to the frozen deployment's stance (§3.4).
    node_datum: RegistryNode,
    /// The initial reference-token datum (§3.3): the baked schedule mirrored
    /// at par (`version: 1`, `extra.value = scale`), with `extra.native_policy`
    /// set to the graduated asset's policy.
    reference_datum: ReferenceDatum,
    /// The beneficiary's PLB-custodied address (PLB payment + holder stake).
    beneficiary_address: Address,
    /// The reference token's address (PLB payment + transformation stake).
    reference_address: Address,
    /// The registry node being covered by this insert (the origin node for the
    /// first instrument). It is spent and re-emitted with `next` = `cip_policy`.
    covering_ref: UtxoRef,
    /// The covering node's address (the registry script address).
    covering_address: Address,
    /// The covering node's continuation datum: the input's fields with
    /// `next` = `cip_policy`.
    covering_datum: RegistryNode,
    /// Index of the protocol-params reference input (`issuance_mint` redeemer).
    params_idx: Int,
    /// Index of the new node output (`issuance_logic` `OutputIndex` proof).
    /// The template's output layout puts the covering node first and the new
    /// node second, so this is 1.
    new_node_ix: Int,
) {
    reference protocol_params {
        ref: protocol_params_ref,
    }

    reference cbor_hex {
        ref: cbor_hex_ref,
    }

    input covering {
        from: covering_address,
        ref: covering_ref,
        datum_is: RegistryNode,
        redeemer: RegistryRedeemer::RegistryInit {},
    }

    input funding {
        from: Signer,
        min_amount: Ada(6000000) + fees,
    }

    mint {
        amount: AnyAsset(cip_policy, principal_name, quantity) +
            AnyAsset(cip_policy, reference_name, 1),
        redeemer: IssuanceMintRedeemer {
            params_idx: params_idx,
        },
    }

    mint {
        amount: AnyAsset(node_policy, cip_policy, 1),
        redeemer: RegistryRedeemer::RegistryInsert {
            key: cip_policy,
            minting_logic_script: Credential::Script {
                hash: issuance_hash,
            },
        },
    }

    cardano::withdrawal {
        from: IssuanceScript,
        amount: 0,
        redeemer: MintingAction::RegisterAndMint {},
    }

    cardano::withdrawal {
        from: CoreIssuanceLogic,
        amount: 0,
        redeemer: {
            cip_policy: MintingRegistryProof::OutputIndex {
                index: new_node_ix,
            },
        },
    }

    output covering_out {
        to: covering_address,
        amount: covering,
        datum: covering_datum,
    }

    output node_out {
        to: covering_address,
        amount: AnyAsset(node_policy, cip_policy, 1) + Ada(2000000),
        datum: node_datum,
    }

    output principal_out {
        to: beneficiary_address,
        amount: AnyAsset(cip_policy, principal_name, quantity) + Ada(2000000),
    }

    output reference_out {
        to: reference_address,
        amount: AnyAsset(cip_policy, reference_name, 1) + Ada(2000000),
        datum: reference_datum,
    }

    output {
        to: Signer,
        amount: funding - Ada(6000000) - fees,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: cip_policy_script,
    }

    cardano::plutus_witness {
        version: 3,
        script: node_policy_script,
    }
}

// ------------------------------------------------------------------- transfer

// Free transfer (T2, §4.2): the full dispatch chain — PLB global
// (`TransferAct`) dispatches the core `transfer`, which resolves the registry
// node and requires our permissive transfer logic. Ownership rides the token
// UTxO's stake credential; the sender signs (design figure). The whole UTxO
// value moves to the recipient; the design's diagram carries no continuation
// datum, and a committed payout key is re-set via T2b.
tx transfer(
    /// The token UTxO's PLB-custodied address (PLB payment + sender stake).
    token_address: Address,
    /// The token UTxO being transferred.
    token_ref: UtxoRef,
    /// The PLB input's `params_idx` (locates the protocol-params reference).
    params_idx: Int,
    /// The chain's index in the canonical sorted withdrawal set (09 §10).
    wdrl_idx: Int,
    /// The instrument's RegistryNode among the reference inputs (core
    /// registry-proof index).
    node_idx: Int,
    /// The instrument's RegistryNode UTxO (reference input).
    node_ref: UtxoRef,
    /// The recipient's PLB-custodied address.
    recipient_address: Address,
) {
    reference protocol_params {
        ref: protocol_params_ref,
    }

    reference registry_node {
        ref: node_ref,
    }

    input token_in {
        from: token_address,
        ref: token_ref,
        redeemer: BaseSpendRedeemer {
            params_idx: params_idx,
            wdrl_idx: wdrl_idx,
        },
    }

    input gas {
        from: Signer,
        min_amount: fees,
    }

    cardano::withdrawal {
        from: PlbGlobal,
        amount: 0,
        redeemer: ProgrammableLogicGlobalRedeemer::TransferAct {},
    }

    cardano::withdrawal {
        from: CoreTransfer,
        amount: 0,
        redeemer: CoreTransferRedeemer {
            proofs: [
                RegistryProof::TokenExists {
                    node_idx: node_idx,
                },
            ],
        },
    }

    cardano::withdrawal {
        from: TransferLogic,
        amount: 0,
        redeemer: TransferAction::Move {},
    }

    output {
        to: recipient_address,
        amount: token_in,
    }

    output {
        to: Signer,
        amount: gas - fees,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: plb_script,
    }
}

// Register payout key (T2b, §4.3): a special case of the transfer — the owner
// spends the token to themselves and writes a payment credential into its
// datum. Only an owner-signed transfer can set it; the third-party graduation
// (§4.5) completes it but can never redirect the payout. Optional and
// re-settable with a later self-transfer. Same path and signatures as the
// free transfer; the only difference is the output datum.
tx register_payout_key(
    /// The token UTxO's PLB-custodied address (self-transfer: same address).
    token_address: Address,
    /// The token UTxO being spent to the owner.
    token_ref: UtxoRef,
    /// The PLB input's `params_idx` (locates the protocol-params reference).
    params_idx: Int,
    /// The chain's index in the canonical sorted withdrawal set (09 §10).
    wdrl_idx: Int,
    /// The instrument's RegistryNode among the reference inputs (core
    /// registry-proof index).
    node_idx: Int,
    /// The instrument's RegistryNode UTxO (reference input).
    node_ref: UtxoRef,
    /// The owner's payout payment credential to commit (§3.2).
    payout_credential: Credential,
) {
    reference protocol_params {
        ref: protocol_params_ref,
    }

    reference registry_node {
        ref: node_ref,
    }

    input token_in {
        from: token_address,
        ref: token_ref,
        redeemer: BaseSpendRedeemer {
            params_idx: params_idx,
            wdrl_idx: wdrl_idx,
        },
    }

    input gas {
        from: Signer,
        min_amount: fees,
    }

    cardano::withdrawal {
        from: PlbGlobal,
        amount: 0,
        redeemer: ProgrammableLogicGlobalRedeemer::TransferAct {},
    }

    cardano::withdrawal {
        from: CoreTransfer,
        amount: 0,
        redeemer: CoreTransferRedeemer {
            proofs: [
                RegistryProof::TokenExists {
                    node_idx: node_idx,
                },
            ],
        },
    }

    cardano::withdrawal {
        from: TransferLogic,
        amount: 0,
        redeemer: TransferAction::Move {},
    }

    output {
        to: token_address,
        amount: token_in,
        datum: PrincipalDatum {
            payment_credential: OptionalCredential::Some {
                credential: payout_credential,
            },
        },
    }

    output {
        to: Signer,
        amount: gas - fees,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: plb_script,
    }
}

// -------------------------------------------------------------- transformation

// Scheduled transformation (T3, §4.4): the reference token's datum is
// rewritten in place on the transfer path — the full dispatch chain plus the
// transformation script's withdraw-0 time gate. The update is a pure lookup
// of the baked constants, so a late submission jumps straight to the current
// step. The output keeps the input's `metadata`, `version` and
// `extra.native_policy` (the published terms are frozen, §3.3) and records
// `extra.value = lookup(schedule, now)`. Holder-passive and permissionless:
// no signatures — the Signer only pays fees; the reference token's stake
// credential (the transformation script) authorizes via its withdraw-0.
tx transform(
    /// The reference token UTxO (CIP-68 `222` × 1).
    reference_ref: UtxoRef,
    /// The reference token's PLB-custodied address (PLB payment +
    /// transformation-script stake).
    reference_address: Address,
    /// The PLB input's `params_idx` (locates the protocol-params reference).
    params_idx: Int,
    /// The chain's index in the canonical sorted withdrawal set (09 §10).
    wdrl_idx: Int,
    /// The instrument's RegistryNode among the reference inputs (core
    /// registry-proof index).
    node_idx: Int,
    /// The instrument's RegistryNode UTxO (reference input).
    node_ref: UtxoRef,
    /// The continuation datum: keeps the input's `metadata` and `version`,
    /// mirrors the baked schedule and the published `native_policy`, and
    /// records `extra.value = lookup(schedule, now)`, computed off-chain from
    /// the same validity lower bound passed as `since_slot` (§4.4).
    reference_datum: ReferenceDatum,
    /// Slot of the validity lower bound; `d1 <= now <= d4` (§5).
    since_slot: Int,
) {
    reference protocol_params {
        ref: protocol_params_ref,
    }

    reference registry_node {
        ref: node_ref,
    }

    input reference_in {
        from: reference_address,
        ref: reference_ref,
        datum_is: ReferenceDatum,
        redeemer: BaseSpendRedeemer {
            params_idx: params_idx,
            wdrl_idx: wdrl_idx,
        },
    }

    input gas {
        from: Signer,
        min_amount: fees,
    }

    cardano::withdrawal {
        from: PlbGlobal,
        amount: 0,
        redeemer: ProgrammableLogicGlobalRedeemer::TransferAct {},
    }

    cardano::withdrawal {
        from: CoreTransfer,
        amount: 0,
        redeemer: CoreTransferRedeemer {
            proofs: [
                RegistryProof::TokenExists {
                    node_idx: node_idx,
                },
            ],
        },
    }

    cardano::withdrawal {
        from: TransferLogic,
        amount: 0,
        redeemer: TransferAction::Move {},
    }

    cardano::withdrawal {
        from: TransformationScript,
        amount: 0,
        redeemer: TransformationAction::Update {},
    }

    output reference_out {
        to: reference_address,
        amount: reference_in,
        datum: reference_datum,
    }

    output {
        to: Signer,
        amount: gas - fees,
    }

    validity {
        since_slot: since_slot,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    cardano::plutus_witness {
        version: 3,
        script: plb_script,
    }
}

// ----------------------------------------------------------------- graduation

// Deadline graduation, owner path (T4, §4.5): the transfer-path spend chain
// (PLB global `TransferAct` -> core `transfer` -> our transfer logic) plus
// the shared burn withdraw-0s (our minting logic `Burn` + the core issuance
// proof). The reference token rides along as a reference input — the burn
// reads the graduated asset's policy (`extra.native_policy`) from its datum
// (§3.3). Burn the principal — whole holdings per name, `quantity` covering
// the holder's full holding — and mint the graduated asset under the native
// policy at the schedule's final value (`native_quantity =
// Σ floor(Q × v4 / scale)`, computed off-chain). The owner signs, which names
// and authorizes the payout destination (Q-GRAD-2). Nothing remains on the
// owner path (the cheaper shape): the burned UTxO's leftover ada returns to
// the Signer.
tx graduate_owner(
    /// The token UTxO's PLB-custodied address (PLB payment + owner stake).
    token_address: Address,
    /// The token UTxO whose whole holding burns.
    token_ref: UtxoRef,
    /// The PLB input's `params_idx` (locates the protocol-params reference).
    params_idx: Int,
    /// The chain's index in the canonical sorted withdrawal set (09 §10).
    wdrl_idx: Int,
    /// The instrument's RegistryNode among the reference inputs (core
    /// registry-proof index).
    node_idx: Int,
    /// The instrument's RegistryNode UTxO (reference input).
    node_ref: UtxoRef,
    /// The reference token UTxO (CIP-68 `222` × 1) — a reference input whose
    /// datum names the graduated asset's policy (§4.5, §3.3).
    reference_ref: UtxoRef,
    /// The burned principal quantity (the holder's whole holding, §4.5).
    quantity: Int,
    /// The graduated quantity: `Σ floor(Q × v4 / scale)` (§4.5).
    native_quantity: Int,
    /// The owner-authorized payout destination (payment + owner stake).
    payout_address: Address,
    /// Slot of the validity lower bound; must be `d4` or later (§5).
    since_slot: Int,
) {
    reference protocol_params {
        ref: protocol_params_ref,
    }

    reference registry_node {
        ref: node_ref,
    }

    reference reference_token {
        ref: reference_ref,
    }

    input token_in {
        from: token_address,
        ref: token_ref,
        redeemer: BaseSpendRedeemer {
            params_idx: params_idx,
            wdrl_idx: wdrl_idx,
        },
    }

    input gas {
        from: Signer,
        min_amount: fees,
    }

    burn {
        amount: AnyAsset(cip_policy, principal_name, quantity),
        redeemer: IssuanceMintRedeemer {
            params_idx: params_idx,
        },
    }

    mint {
        amount: AnyAsset(native_policy, principal_name, native_quantity),
        redeemer: (),
    }

    cardano::withdrawal {
        from: PlbGlobal,
        amount: 0,
        redeemer: ProgrammableLogicGlobalRedeemer::TransferAct {},
    }

    cardano::withdrawal {
        from: CoreTransfer,
        amount: 0,
        redeemer: CoreTransferRedeemer {
            proofs: [
                RegistryProof::TokenExists {
                    node_idx: node_idx,
                },
            ],
        },
    }

    cardano::withdrawal {
        from: TransferLogic,
        amount: 0,
        redeemer: TransferAction::Move {},
    }

    cardano::withdrawal {
        from: IssuanceScript,
        amount: 0,
        redeemer: MintingAction::Burn {},
    }

    cardano::withdrawal {
        from: CoreIssuanceLogic,
        amount: 0,
        redeemer: {
            cip_policy: MintingRegistryProof::RefInput {
                index: node_idx,
            },
        },
    }

    output native_out {
        to: payout_address,
        amount: AnyAsset(native_policy, principal_name, native_quantity) +
            Ada(2000000),
    }

    output {
        to: Signer,
        amount: token_in - AnyAsset(cip_policy, principal_name, quantity) -
            Ada(2000000) + gas - fees,
    }

    validity {
        since_slot: since_slot,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: cip_policy_script,
    }

    cardano::plutus_witness {
        version: 3,
        script: native_mint_script,
    }

    cardano::plutus_witness {
        version: 3,
        script: plb_script,
    }
}

// Deadline graduation, third-party path (T4, §4.5): the permissionless arm —
// the third-party dispatch chain (PLB global `ThirdPartyAct` -> core
// `third_party` -> our third-party logic) plus the same burn withdraw-0s. The
// reference token rides along as a reference input — the burn reads the
// graduated asset's policy (`extra.native_policy`) from its datum (§3.3). No
// signature: it only works for tokens whose owner pre-committed a payout
// payment credential to the token datum (§4.3) — the template enforces that
// by typing the spent input's datum, and the paired ghost continuation
// preserves the spent UTxO's address and datum byte-for-byte (lovelace
// ratcheted: the ghost keeps the burned UTxO's ada, reclaimable by the owner
// via a transfer-path spend), so a completer can complete but never redirect.
tx graduate_third_party(
    /// The token UTxO's PLB-custodied address (PLB payment + owner stake);
    /// also the ghost continuation's address (preserved byte-for-byte).
    token_address: Address,
    /// The token UTxO whose whole holding burns. Must carry the owner's
    /// pre-committed payout payment credential (§4.3) — Q-GRAD-2.
    token_ref: UtxoRef,
    /// The PLB input's `params_idx` (locates the protocol-params reference).
    params_idx: Int,
    /// The chain's index in the canonical sorted withdrawal set (09 §10).
    wdrl_idx: Int,
    /// The instrument's RegistryNode among the reference inputs (core
    /// registry-proof index).
    node_idx: Int,
    /// The instrument's RegistryNode UTxO (reference input).
    node_ref: UtxoRef,
    /// First output paired with the processed PLB inputs (core
    /// `ThirdPartyRedeemer`). The template emits the native payout first and
    /// the ghost continuation second, so this is 1.
    outputs_start_idx: Int,
    /// The reference token UTxO (CIP-68 `222` × 1) — a reference input whose
    /// datum names the graduated asset's policy (§4.5, §3.3).
    reference_ref: UtxoRef,
    /// The burned principal quantity (the holder's whole holding, §4.5).
    quantity: Int,
    /// The graduated quantity: `Σ floor(Q × v4 / scale)` (§4.5).
    native_quantity: Int,
    /// The owner-committed payout destination (§4.3).
    payout_address: Address,
    /// Slot of the validity lower bound; must be `d4` or later (§5).
    since_slot: Int,
) {
    reference protocol_params {
        ref: protocol_params_ref,
    }

    reference registry_node {
        ref: node_ref,
    }

    reference reference_token {
        ref: reference_ref,
    }

    input token_in {
        from: token_address,
        ref: token_ref,
        datum_is: PrincipalDatum,
        redeemer: BaseSpendRedeemer {
            params_idx: params_idx,
            wdrl_idx: wdrl_idx,
        },
    }

    input gas {
        from: Signer,
        min_amount: Ada(2000000) + fees,
    }

    burn {
        amount: AnyAsset(cip_policy, principal_name, quantity),
        redeemer: IssuanceMintRedeemer {
            params_idx: params_idx,
        },
    }

    mint {
        amount: AnyAsset(native_policy, principal_name, native_quantity),
        redeemer: (),
    }

    cardano::withdrawal {
        from: PlbGlobal,
        amount: 0,
        redeemer: ProgrammableLogicGlobalRedeemer::ThirdPartyAct {},
    }

    cardano::withdrawal {
        from: CoreThirdParty,
        amount: 0,
        redeemer: CoreThirdPartyRedeemer {
            registry_node_idx: node_idx,
            outputs_start_idx: outputs_start_idx,
        },
    }

    cardano::withdrawal {
        from: ThirdPartyLogic,
        amount: 0,
        redeemer: ThirdPartyAction::Graduate {},
    }

    cardano::withdrawal {
        from: IssuanceScript,
        amount: 0,
        redeemer: MintingAction::Burn {},
    }

    cardano::withdrawal {
        from: CoreIssuanceLogic,
        amount: 0,
        redeemer: {
            cip_policy: MintingRegistryProof::RefInput {
                index: node_idx,
            },
        },
    }

    output native_out {
        to: payout_address,
        amount: AnyAsset(native_policy, principal_name, native_quantity) +
            Ada(2000000),
    }

    output ghost_out {
        to: token_address,
        amount: token_in - AnyAsset(cip_policy, principal_name, quantity),
        datum: PrincipalDatum {
            payment_credential: token_in.payment_credential,
        },
    }

    output {
        to: Signer,
        amount: gas - Ada(2000000) - fees,
    }

    validity {
        since_slot: since_slot,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    cardano::plutus_witness {
        version: 3,
        script: cip_policy_script,
    }

    cardano::plutus_witness {
        version: 3,
        script: native_mint_script,
    }

    cardano::plutus_witness {
        version: 3,
        script: plb_script,
    }
}

// ============================================================
// TEST KIT — CIP-113 core bootstrap only.
//
// Consumed exclusively by `tests/devnet.test.ts` to deploy the vendored
// CIP-113 core on a fresh trix devnet: the one-shot registry, issuance
// template, upgrade-config and protocol-params mints. Never used by the bond
// lifecycle builders. Safe to delete wholesale.
// ============================================================

/// Initialize the core registry with its origin node (one-shot).
tx core_init_registry(
    /// The one-shot UTxO the applied registry policy is parameterized with.
    registry_ref: UtxoRef,
    /// The registry script address (payment = registry node policy).
    node_address: Address,
    /// The origin node datum: empty key, sentinel next, empty logic fields.
    node_datum: RegistryNode,
) {
    input registry_seed {
        from: Signer,
        ref: registry_ref,
        min_amount: Ada(2000000) + fees,
    }

    mint {
        amount: AnyAsset(node_policy, "", 1),
        redeemer: RegistryRedeemer::RegistryInit {},
    }

    output origin_node {
        to: node_address,
        amount: AnyAsset(node_policy, "", 1) + Ada(2000000),
        datum: node_datum,
    }

    output {
        to: Signer,
        amount: registry_seed - Ada(2000000) - fees,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: node_policy_script,
    }
}

/// Mint the one-shot issuance-template reference NFT, locked at the
/// always-fail address with the `IssuanceCborHex` datum.
tx core_init_cbor_hex(
    /// The one-shot UTxO the applied `issuance_cbor_hex_mint` is
    /// parameterized with.
    cbor_ref: UtxoRef,
    /// The always-fail script address the template NFT is locked at.
    lock_address: Address,
    /// The template split: prefix and postfix around the minting-logic hash.
    cbor_datum: IssuanceCborHex,
) {
    input cbor_seed {
        from: Signer,
        ref: cbor_ref,
        min_amount: Ada(2000000) + fees,
    }

    mint {
        amount: AnyAsset(cbor_hex_policy, "IssuanceCborHex", 1),
        redeemer: (),
    }

    output cbor_out {
        to: lock_address,
        amount: AnyAsset(cbor_hex_policy, "IssuanceCborHex", 1) + Ada(2000000),
        datum: cbor_datum,
    }

    output {
        to: Signer,
        amount: cbor_seed - Ada(2000000) - fees,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: cbor_hex_script,
    }
}

/// Mint the one-shot upgrade-multisig config NFT holding the approval tree.
tx core_init_upgrade_config(
    /// The one-shot UTxO the applied `upgrade_multisig` is parameterized with.
    config_ref: UtxoRef,
    /// The upgrade-multisig script address the config UTxO is locked at.
    config_address: Address,
    /// The approval tree (a single-signature tree in the test bootstrap).
    config_datum: UpgradeMultisigDatum,
) {
    input config_seed {
        from: Signer,
        ref: config_ref,
        min_amount: Ada(2000000) + fees,
    }

    mint {
        amount: AnyAsset(upgrade_multisig_policy, "UpgradeMultisig", 1),
        redeemer: (),
    }

    output config_out {
        to: config_address,
        amount: AnyAsset(upgrade_multisig_policy, "UpgradeMultisig", 1) +
            Ada(2000000),
        datum: config_datum,
    }

    output {
        to: Signer,
        amount: config_seed - Ada(2000000) - fees,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: upgrade_multisig_script,
    }
}

/// Mint the one-shot protocol-params NFT with the live wiring datum. The
/// sitting upgrade authority's withdraw-0 authorises the genesis.
tx core_init_protocol_params(
    /// The one-shot UTxO the applied `protocol_params` is parameterized with.
    params_ref: UtxoRef,
    /// The upgrade-multisig config UTxO (reference input for its withdraw-0).
    config_ref: UtxoRef,
    /// The protocol-params script address the NFT is locked at.
    params_address: Address,
    /// The live wiring: the five credentials and an empty nomination.
    params_datum: ProtocolParamsDatum,
) {
    input params_seed {
        from: Signer,
        ref: params_ref,
        min_amount: Ada(2000000) + fees,
    }

    reference upgrade_config {
        ref: config_ref,
    }

    mint {
        amount: AnyAsset(params_policy, "ProtocolParams", 1),
        redeemer: (),
    }

    cardano::withdrawal {
        from: UpgradeMultisig,
        amount: 0,
        redeemer: (),
    }

    output params_out {
        to: params_address,
        amount: AnyAsset(params_policy, "ProtocolParams", 1) + Ada(2000000),
        datum: params_datum,
    }

    output {
        to: Signer,
        amount: params_seed - Ada(2000000) - fees,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: params_script,
    }
}
