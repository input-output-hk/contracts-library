// Event-triggered assets — tokenized bond (Tx3 off-chain).
//
// Reference Tx3 implementation of the event-triggered assets CIP-113
// substandard (issue #28), mirroring the on-chain validators in
// `onchain/validators/event_triggered_assets.ak` and
// `onchain/lib/event_triggered/`. The normative spec is
// `docs/event-triggered-assets/spec.md`; these templates follow the flows of
// `docs/event-triggered-assets/design.typ`.
//
// Model: the instrument is registered once (registry insert) and then deposits
// are permissionless per unit — each deposit moves `vault_principal` lovelace
// into a chosen vault and mints one CIP-113 **certificate** at the Programmable
// Logic Base. The certificate's asset name is one byte: its current step (`0`
// at deposit, `N` at maturity); its inline datum carries
// `{ start, commit, cnt_policy }`. Over the bond's life a certificate claims
// scheduled **coupon** tokens under its vault's coupon policy (asset name = the
// decimal lovelace amount) and redeems them at that vault (burn-to-pay). At
// maturity it claims a principal-only coupon and is retired. Every advance or
// retirement carries its coupon — presence is enforced on both the owner and
// the issuer paths.
//
// The instrument ships three withdraw-zero validators — `issuance` (minting
// logic and registration authority), `transfer` (name-monotone) and
// `third_party` (the opt-in issuer trigger) — plus a `vault` spending validator
// and a per-vault `coupon_policy` mint policy (and the `vault_nft_policy` the
// vault is authenticated by). Every PLB spend runs the core dispatch chain
// (`programmable_logic_global [TransferAct | ThirdPartyAct] -> transfer |
// third_party [core] -> transfer_logic | third_party_logic (ours)`), every
// mint/burn under the governed policy runs the core `issuance_mint` ->
// `issuance_logic`, and registration rides the core registry mint handlers.
//
// Script-material convention: tx3 hashes the exact bytes it is handed as a
// witness (`blake2b224(0x03 || bytes)`) and the Plutus evaluator CBOR-decodes
// those bytes, so every `*_script` value is the script's single-CBOR "payload"
// form. The off-chain helpers that compute them (the library's `applyBond` and
// `applyParamsToScript`) are normalized to that form — see `tests/cip113.ts`.
//
// Every PLB input carries `BaseSpendRedeemer { params_idx, wdrl_idx }` — one
// record per PLB input, no action arm; the path is selected by the dispatcher's
// redeemer, never by the base redeemer (design T2 notes). `params_idx` locates
// the protocol-params reference input; `wdrl_idx` is derived from the canonical
// sorted withdrawal set (scripts before vkeys, ascending — 09-DEVELOPING-MODULES
// §10). Both are caller-supplied, and both count the *complete* ledger sets:
// every reference-script UTxO behind a `policy { ref: ... }` is a reference
// input, so the tests sort all of them.
//
// The coupon terms (`interval`, `amounts`, `principal`) are baked into each
// vault's coupon policy; the certificate's `cnt_policy` datum selects them.
// Coupon names are the decimal lovelace amount (`"1040"`), so the tests
// compute them with the library's `couponName`.
//
// Authorization: the issuer signs the registration, the vault creation, the
// issuer-triggered claims and the issuer-path graduation; the certificate
// holder signs transfers, opt-ins and owner-path claims and graduation. The
// third-party path carries no holder signature — it requires the owner's
// pre-committed payment credential (`commit`) in the certificate datum, and the
// coupon minted is bound to it.
//
// The transactions:
//
//   create_vault         §3.1: mint the vault NFT into a funded vault
//   register             §4.1: registry insert (no certificate)
//   deposit              §4.2: unit deposit → certificate (step 0)
//   transfer             §4.3: plain transfer / owner change
//   authorize            §4.4: self-transfer committing a payout credential
//   claim_owner          §4.5: owner-signed coupon claim (advance)
//   claim_issuer         §4.5: issuer-triggered claim (third-party path)
//   redeem               §4.6: burn-to-pay at the vault
//   graduate_owner       §4.7: owner-signed retirement + principal coupon
//   graduate_issuer      §4.7: issuer-triggered retirement (ghost shell)

env {
    /// The governed policy id — hash of the `issuance_mint` script
    /// parameterized by this instrument's minting-logic credential.
    cip_policy: Bytes,
    /// The applied `issuance_mint` minting policy (single-CBOR payload).
    cip_policy_script: Bytes,
    /// Policy id of the core registry's node-NFT policy (the registry mint
    /// handler).
    node_policy: Bytes,
    /// The applied registry node-NFT minting policy (single-CBOR payload).
    node_policy_script: Bytes,
    /// The applied PLB base spend script guarding the certificate UTxOs
    /// (single-CBOR payload); the redeemers are the `BaseSpendRedeemer` /
    /// dispatcher arms.
    plb_script: Bytes,
    /// The protocol-params reference input every minting transaction carries.
    protocol_params_ref: UtxoRef,
    /// UTxO carrying the PLB global (dispatcher) stake script as a reference
    /// script; its withdraw-0 carries the `TransferAct` / `ThirdPartyAct`.
    plb_global_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the PLB global's withdraw-0.
    plb_global_script_address: Bytes,
    /// UTxO carrying the core `transfer` stake script as a reference script.
    core_transfer_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the core `transfer` withdraw-0.
    core_transfer_script_address: Bytes,
    /// UTxO carrying the core `third_party` stake script as a reference script.
    core_third_party_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the core `third_party` withdraw-0.
    core_third_party_script_address: Bytes,
    /// UTxO carrying the core `issuance_logic` stake script as a reference
    /// script; its withdraw-0 proves the names policy + registry proof on every
    /// governed mint/burn.
    core_issuance_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the core issuance logic's withdraw-0.
    core_issuance_script_address: Bytes,
    /// UTxO carrying the issuance (minting) logic as a reference script; its
    /// withdraw-0 carries the `Register` / `Deposit` / `Advance` / `Retire`
    /// mode (§4.1, §4.2, §4.5, §4.7).
    issuance_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the issuance logic's withdraw-0.
    issuance_script_address: Bytes,
    /// UTxO carrying the name-monotone transfer logic as a reference script.
    transfer_logic_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the transfer logic's withdraw-0.
    transfer_logic_script_address: Bytes,
    /// UTxO carrying the issuer-triggered third-party logic as a reference
    /// script.
    third_party_logic_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the third-party logic's withdraw-0.
    third_party_logic_script_address: Bytes,
    /// Script hash of the issuance (minting) logic — the credential the
    /// registry node pins as `minting_logic_script` and the `RegistryInsert`
    /// redeemer carries.
    issuance_hash: Bytes,
    /// Policy id of the vault's coupon policy (bakes the coupon terms).
    coupon_policy: Bytes,
    /// The applied coupon policy (single-CBOR payload).
    coupon_script: Bytes,
    /// The applied vault spending validator (single-CBOR payload).
    vault_script: Bytes,
    /// Policy id of the vault NFT policy (I10).
    vault_nft_policy: Bytes,
    /// The applied vault NFT policy (single-CBOR payload).
    vault_nft_script: Bytes,
    /// Asset name of each vault's NFT (hex).
    vault_nft_name: Bytes,
    /// The unit principal, in lovelace — a deposit must add exactly this to the
    /// chosen vault (I6).
    vault_principal: Int,
    /// Policy id of the core `issuance_cbor_hex_mint` (the template reference
    /// NFT policy); TEST KIT bootstrap only.
    cbor_hex_policy: Bytes,
    /// The applied `issuance_cbor_hex_mint` policy script; TEST KIT only.
    cbor_hex_script: Bytes,
    /// UTxO holding the `IssuanceCborHex` template reference NFT (the always-
    /// fail lock). The registry's insert proof derives the governed policy
    /// from it, so every `register` carries it as a reference input.
    cbor_hex_ref: UtxoRef,
    /// Policy id of the core `upgrade_multisig` config policy; TEST KIT only.
    upgrade_multisig_policy: Bytes,
    /// The applied `upgrade_multisig` script; TEST KIT only.
    upgrade_multisig_script: Bytes,
    /// UTxO carrying the applied `upgrade_multisig` script as a reference
    /// script (its withdraw-0 runs from here); TEST KIT only.
    upgrade_multisig_script_ref: UtxoRef,
    /// Stake (reward) address bytes of the upgrade multisig's withdraw-0.
    upgrade_multisig_stake_address: Bytes,
    /// Policy id of the core `protocol_params` NFT policy; TEST KIT only.
    params_policy: Bytes,
    /// The applied `protocol_params` script; TEST KIT only.
    params_script: Bytes,
}

/// The transacting key holder: the issuer (registration, vault creation,
/// issuer-triggered paths) or the certificate holder (transfers, opt-ins,
/// owner-path claims and graduation, redemptions).
party Signer;

// ------------------------------------------------------------------- policies

// The PLB global (dispatcher) withdraw-0 — the first leg of every PLB spend
// chain; its `ProgrammableLogicGlobalRedeemer` (`TransferAct` /
// `ThirdPartyAct`) selects the path.
policy PlbGlobal {
    ref: plb_global_script_ref,
    hash: plb_global_script_address,
}

// The core `transfer` stake validator withdraw-0 — the dispatch's second leg
// on the transfer path. Its `CoreTransferRedeemer` carries one
// `TokenExists { node_idx }` proof per distinct spent policy.
policy CoreTransfer {
    ref: core_transfer_script_ref,
    hash: core_transfer_script_address,
}

// The core `third_party` stake validator withdraw-0 — the dispatch's second
// leg on the third-party path. Its `CoreThirdPartyRedeemer` names the subject
// policy's registry node and the first paired continuation output.
policy CoreThirdParty {
    ref: core_third_party_script_ref,
    hash: core_third_party_script_address,
}

// The core issuance logic withdraw-0 — proves the names policy and its
// registry proof on every mint/burn under the governed policy.
policy CoreIssuanceLogic {
    ref: core_issuance_script_ref,
    hash: core_issuance_script_address,
}

// The issuance (minting) logic withdraw-0, carrying the `Register` / `Deposit`
// / `Advance` / `Retire` mode redeemer. Tx3 does not attach a script witness to
// a withdrawal keyed by an inline script, so the script travels as a reference
// input (the settings-contract pattern); the `ref` UTxO supplies it.
policy IssuanceScript {
    ref: issuance_script_ref,
    hash: issuance_script_address,
}

// The name-monotone transfer logic withdraw-0 (§4.3).
policy TransferLogic {
    ref: transfer_logic_script_ref,
    hash: transfer_logic_script_address,
}

// The issuer-triggered third-party logic withdraw-0 (§4.5, §4.7).
policy ThirdPartyLogic {
    ref: third_party_logic_script_ref,
    hash: third_party_logic_script_address,
}

// TEST KIT bootstrap only: the upgrade authority's withdraw-0. The script
// travels as a reference script (the resolver has no ref for it before the
// core is up, so the test publishes it between the config and params genesis).
policy UpgradeMultisig {
    ref: upgrade_multisig_script_ref,
    hash: upgrade_multisig_stake_address,
}

// ---------------------------------------------------------------------- types

// `Credential` in the Aiken sense: constructor 0 is a key credential,
// constructor 1 a script credential. The carried value is a Blake2b-224 hash.
type Credential {
    Key {
        hash: Bytes,
    },
    Script {
        hash: Bytes,
    },
}

// `Option<Credential>` — `Some` is constructor 0, `None` constructor 1.
type OptionalCredential {
    Some {
        credential: Credential,
    },
    None,
}

// Aiken `Referenced<Credential>` (the stdlib's `StakeCredential`); only the
// `Inline` arm is ever produced here.
type StakeCredentialData {
    Inline {
        credential: Credential,
    },
}

// Aiken `Option<StakeCredential>` — `Some` 0, `None` 1.
type OptionalStakeCredential {
    Some {
        stake: StakeCredentialData,
    },
    None,
}

// Aiken `cardano/address.Address` in its **data** form:
// `Constr 0 [PaymentCredential, Option<StakeCredential>]`. The `Address`
// primitive serializes as raw address bytes, which a validator decoding an
// `Address` from data cannot read, so redeemers that carry an address build
// the constructor form explicitly.
type AddrData {
    payment_credential: Credential,
    stake_credential: OptionalStakeCredential,
}

// Inline datum of a certificate (§3.3): the per-certificate claim state. The
// step lives in the asset name; the coupon terms live in the coupon policy
// selected by `cnt_policy`.
type CertificateDatum {
    start: Int,
    commit: OptionalCredential,
    cnt_policy: Bytes,
}

// Inline datum of a vault (§3.1): binds the coupon policy whose negative mints
// the `Redeem` path honors. The vault owner lives off-chain (§7).
type VaultDatum {
    cnt_policy: Bytes,
}

// The core registry's node datum (§3.4), field order per
// `onchain/lib/event_triggered/types.ak` (positional CBOR encoding). The
// unfracking hook uses the `empty_vkey` convention — `VerificationKey(#"")`,
// which forbids unfracking — so its type is `Credential`, not an optional.
type RegistryNode {
    key: Bytes,
    next: Bytes,
    minting_logic_script: Credential,
    transfer_logic_script: Credential,
    third_party_logic_script: Credential,
    unfracking_logic_script: Credential,
    global_state_cs: Bytes,
}

// The PLB base spend redeemer: one record per PLB input in the transaction;
// it carries *no action arm* — the path is selected by the dispatcher's
// redeemer (design T2 notes). `params_idx` locates the protocol-params
// reference input; `wdrl_idx` is the chain's index in the canonical sorted
// withdrawal set (09-DEVELOPING-SUBSTANDARDS §10).
type BaseSpendRedeemer {
    params_idx: Int,
    wdrl_idx: Int,
}

// Mode redeemer of the minting-logic withdraw-0 (§4.1, §4.2, §4.5, §4.7).
// Encodes as `Constr 0 []` … `Constr 3 []`.
type MintingAction {
    Register,
    Deposit,
    Advance,
    Retire,
}

// Redeemer of the transfer-logic withdraw-0 — permissive, no rules (§4.3).
type TransferAction {
    Move,
}

// Redeemer of the third-party logic withdraw-0 (§4.5, §4.7): the opt-in
// issuer trigger.
type ThirdPartyAction {
    Trigger,
}

// One payout the redeemer names on a redemption (§4.6). The address is the
// Aiken data form (see `AddrData`).
type Payout {
    address: AddrData,
    amount: Int,
}

// Redeemer of the vault spending validator (§4.2, §4.6).
type VaultAction {
    VaultDeposit,
    Redeem {
        payouts: List<Payout>,
    },
}

// ----------------------------------------------------------------- core types

// `RegistryProof` (core `lib/types.ak`): a direct index into `reference_inputs`
// proving membership (`TokenExists`) or, via a covering node,
// non-membership (`TokenDoesNotExist`). Constructor order matters.
type RegistryProof {
    TokenExists {
        node_idx: Int,
    },
    TokenDoesNotExist {
        node_idx: Int,
    },
}

// The core `registry` redeemer: `RegistryInit` mints the origin node;
// `RegistryInsert` mints a token's node and pins the issuance credential.
type RegistryRedeemer {
    RegistryInit,
    RegistryInsert {
        key: Bytes,
        minting_logic_script: Credential,
    },
}

// Redeemer of the core `transfer` withdraw-0: one registry proof per distinct
// spent policy, in ascending policy order.
type CoreTransferRedeemer {
    proofs: List<RegistryProof>,
}

// Redeemer of the core `programmable_logic_global` dispatcher: only the arms
// this instrument uses (the core also has `UnfrackingAct`).
type ProgrammableLogicGlobalRedeemer {
    TransferAct,
    ThirdPartyAct,
}

// Redeemer of the core `third_party` withdraw-0: the subject policy's registry
// node index in the reference inputs, and the first output paired with the
// processed PLB inputs.
type CoreThirdPartyRedeemer {
    registry_node_idx: Int,
    outputs_start_idx: Int,
}

// Redeemer of the core `issuance_mint` policy: the protocol-params index in
// the reference inputs.
type IssuanceMintRedeemer {
    params_idx: Int,
}

// `MintingRegistryProof` (core `lib/types.ak`): `OutputIndex` points at a
// registry node created in this transaction (first mint); `RefInput` points at
// a referenced node (already registered). Constructor order matters.
type MintingRegistryProof {
    RefInput {
        index: Int,
    },
    OutputIndex {
        index: Int,
    },
}

// The core `issuance_logic` withdraw-0 redeemer: a Plutus MAP keyed by the
// governed policy, one proof per policy issued (minted or burned) in this
// transaction.
type IssuanceLogicRedeemer = Map<Bytes, MintingRegistryProof>;

// --------------------------------------------------------- bootstrap types

// `IssuanceCborHex` reference datum (core `lib/types.ak`): the `issuance_mint`
// template split around the minting-logic script hash.
type IssuanceCborHex {
    prefix_cbor_hex: Bytes,
    postfix_cbor_hex: Bytes,
}

// The upgrade authority's approval tree (core `lib/multisig.ak`). The test
// bootstrap only ever deploys a single-signature tree, so the recursive cases
// are not carried here.
type UpgradeMultisigDatum {
    Signature {
        key_hash: Bytes,
    },
}

// The core `ProtocolParams` datum (field order per `programmable_logic/params`).
type ProtocolParamsDatum {
    programmable_logic_global_cred: Credential,
    issuance_logic_cred: Credential,
    transfer_cred: Credential,
    third_party_cred: Credential,
    upgrade_cred: Credential,
    pending_upgrade_cred: OptionalCredential,
}

// ---------------------------------------------------------------- create vault

// Vault creation (§3.1, I10): the deployment's authority mints the vault's
// single NFT into a newly funded vault UTxO carrying the `VaultDatum` (which
// binds the instrument's coupon policy). Creation is out of scope for the
// on-chain validators; this template is the reference shape the tests use, and
// the vault NFT policy is the only thing checked.
tx create_vault(
    /// The vault script address.
    vault_address: Address,
    /// ADA the vault starts with (coupon reserve + deposits).
    vault_ada: Int,
) {
    input funding {
        from: Signer,
        min_amount: Ada(vault_ada) + fees,
    }

    mint {
        amount: AnyAsset(vault_nft_policy, vault_nft_name, 1),
        redeemer: (),
    }

    output vault_out {
        to: vault_address,
        amount: AnyAsset(vault_nft_policy, vault_nft_name, 1) + Ada(vault_ada),
        datum: VaultDatum {
            cnt_policy: coupon_policy,
        },
    }

    output {
        to: Signer,
        amount: funding - Ada(vault_ada) - fees,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: vault_nft_script,
    }
}

// ------------------------------------------------------------------- register

// Registration (§4.1): create the instrument's RegistryNode and pin its stance
// to the frozen deployment. No certificate is minted — the same registration
// serves every later deposit. The covering registry node is spent and
// re-emitted with `next` pointing at the new node (core registry linked list).
// Withdraw-0s: ours (`Register`). The issuer signs.
tx register(
    /// The registry node datum: `key` = `cip_policy`, the logic fields pinned
    /// to the frozen deployment's stance.
    node_datum: RegistryNode,
    /// The registry node being covered by this insert (the origin node for the
    /// first instrument). It is spent and re-emitted with `next` = `cip_policy`.
    covering_ref: UtxoRef,
    /// The covering node's address (the registry script address).
    covering_address: Address,
    /// The covering node's continuation datum: the input's fields with
    /// `next` = `cip_policy`.
    covering_datum: RegistryNode,
) {
    reference cbor_hex {
        ref: cbor_hex_ref,
    }

    input covering {
        from: covering_address,
        ref: covering_ref,
        datum_is: RegistryNode,
        redeemer: RegistryRedeemer::RegistryInit {},
    }

    input funding {
        from: Signer,
        min_amount: Ada(2000000) + fees,
    }

    mint {
        amount: AnyAsset(node_policy, cip_policy, 1),
        redeemer: RegistryRedeemer::RegistryInsert {
            key: cip_policy,
            minting_logic_script: Credential::Script {
                hash: issuance_hash,
            },
        },
    }

    cardano::withdrawal {
        from: IssuanceScript,
        amount: 0,
        redeemer: MintingAction::Register {},
    }

    output covering_out {
        to: covering_address,
        amount: covering,
        datum: covering_datum,
    }

    output node_out {
        to: covering_address,
        amount: AnyAsset(node_policy, cip_policy, 1) + Ada(2000000),
        datum: node_datum,
    }

    output {
        to: Signer,
        amount: funding - Ada(2000000) - fees,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: node_policy_script,
    }
}

// -------------------------------------------------------------------- deposit

// Unit deposit (§4.2), permissionless: the chosen vault gains exactly the unit
// `vault_principal` and continues with address, datum and NFT unchanged (I6),
// and exactly one step-`0` certificate is minted at the depositor's
// PLB-custodied address, carrying the vault's `cnt_policy`, `commit: None` and
// `start` pinned to the transaction's finite validity upper bound. Withdraw-0s:
// ours (`Deposit`) plus the core issuance proof (`RefInput` on the node).
// The depositor pays the fees.
tx deposit(
    /// The chosen vault's script address.
    vault_address: Address,
    /// The vault UTxO being deposited into. It is spent and re-emitted with
    /// `+ vault_principal`.
    vault_ref: UtxoRef,
    /// The vault's datum (the continuation preserves it byte-for-byte).
    vault_datum: VaultDatum,
    /// The depositor's PLB-custodied address (PLB payment + holder stake).
    certificate_address: Address,
    /// The certificate's step-`0` asset name (one byte).
    step_name: Bytes,
    /// POSIX-ms start; must equal the validity range's upper bound.
    start: Int,
    /// Slot whose validity upper bound is exactly `start`.
    until_slot: Int,
    /// Index of the protocol-params reference input (`issuance_mint` redeemer).
    params_idx: Int,
    /// The instrument's RegistryNode among the reference inputs (core
    /// issuance-proof index).
    node_idx: Int,
    /// The instrument's RegistryNode UTxO (reference input).
    node_ref: UtxoRef,
) {
    reference protocol_params {
        ref: protocol_params_ref,
    }

    reference registry_node {
        ref: node_ref,
    }

    input vault_in {
        from: vault_address,
        ref: vault_ref,
        datum_is: VaultDatum,
        redeemer: VaultAction::VaultDeposit {},
    }

    input funding {
        from: Signer,
        min_amount: Ada(vault_principal) + Ada(2000000) + fees,
    }

    mint {
        amount: AnyAsset(cip_policy, step_name, 1),
        redeemer: IssuanceMintRedeemer {
            params_idx: params_idx,
        },
    }

    cardano::withdrawal {
        from: IssuanceScript,
        amount: 0,
        redeemer: MintingAction::Deposit {},
    }

    cardano::withdrawal {
        from: CoreIssuanceLogic,
        amount: 0,
        redeemer: {
            cip_policy: MintingRegistryProof::RefInput {
                index: node_idx,
            },
        },
    }

    output vault_out {
        to: vault_address,
        amount: vault_in + Ada(vault_principal),
        datum: vault_datum,
    }

    output certificate_out {
        to: certificate_address,
        amount: AnyAsset(cip_policy, step_name, 1) + Ada(2000000),
        datum: CertificateDatum {
            start: start,
            commit: OptionalCredential::None {},
            cnt_policy: coupon_policy,
        },
    }

    output {
        to: Signer,
        amount: funding - Ada(vault_principal) - Ada(2000000) - fees,
    }

    validity {
        until_slot: until_slot,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: cip_policy_script,
    }

    cardano::plutus_witness {
        version: 3,
        script: vault_script,
    }
}

// ------------------------------------------------------------------- transfer

// Plain transfer / owner change (§4.3): the transfer dispatch chain moves the
// certificate to the recipient's PLB-custodied address with the step name
// preserved. The continuation datum is caller-supplied: an owner change must
// clear `commit`; a self-transfer may set it (use `authorize`). The sender
// signs.
tx transfer(
    /// The certificate UTxO's PLB-custodied address.
    certificate_address: Address,
    /// The certificate UTxO being transferred.
    certificate_ref: UtxoRef,
    /// The recipient's PLB-custodied address.
    recipient_address: Address,
    /// The continuation datum (the new claim state).
    certificate_datum: CertificateDatum,
    /// The PLB input's `params_idx` (locates the protocol-params reference).
    params_idx: Int,
    /// The instrument's RegistryNode among the reference inputs (core
    /// registry-proof index).
    node_idx: Int,
    /// The chain's index in the canonical sorted withdrawal set (09 §10).
    wdrl_idx: Int,
    /// The instrument's RegistryNode UTxO (reference input).
    node_ref: UtxoRef,
) {
    reference protocol_params {
        ref: protocol_params_ref,
    }

    reference registry_node {
        ref: node_ref,
    }

    input certificate_in {
        from: certificate_address,
        ref: certificate_ref,
        datum_is: CertificateDatum,
        redeemer: BaseSpendRedeemer {
            params_idx: params_idx,
            wdrl_idx: wdrl_idx,
        },
    }

    input gas {
        from: Signer,
        min_amount: fees,
    }

    cardano::withdrawal {
        from: PlbGlobal,
        amount: 0,
        redeemer: ProgrammableLogicGlobalRedeemer::TransferAct {},
    }

    cardano::withdrawal {
        from: CoreTransfer,
        amount: 0,
        redeemer: CoreTransferRedeemer {
            proofs: [
                RegistryProof::TokenExists {
                    node_idx: node_idx,
                },
            ],
        },
    }

    cardano::withdrawal {
        from: TransferLogic,
        amount: 0,
        redeemer: TransferAction::Move {},
    }

    output certificate_out {
        to: recipient_address,
        amount: certificate_in,
        datum: certificate_datum,
    }

    output {
        to: Signer,
        amount: gas - fees,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: plb_script,
    }
}

// ------------------------------------------------------------------ authorize

// Opt-in / opt-out (§4.4): a self-transfer to the same PLB-custodied address
// that writes a payment credential into `commit` (or clears it). Only an
// owner-signed self-transfer can set it; the issuer-triggered paths complete
// it but can never redirect the payout. Same chain and signatures as the free
// transfer; the continuation preserves `start` and `cnt_policy` byte-for-byte
// and only `commit` changes.
tx authorize(
    /// The certificate UTxO's PLB-custodied address (self-transfer: same).
    certificate_address: Address,
    /// The certificate UTxO being spent to the owner.
    certificate_ref: UtxoRef,
    /// The new commitment (`Some(pay)`); pass `None` to revoke.
    payout_credential: OptionalCredential,
    /// The PLB input's `params_idx` (locates the protocol-params reference).
    params_idx: Int,
    /// The instrument's RegistryNode among the reference inputs (core
    /// registry-proof index).
    node_idx: Int,
    /// The chain's index in the canonical sorted withdrawal set (09 §10).
    wdrl_idx: Int,
    /// The instrument's RegistryNode UTxO (reference input).
    node_ref: UtxoRef,
) {
    reference protocol_params {
        ref: protocol_params_ref,
    }

    reference registry_node {
        ref: node_ref,
    }

    input certificate_in {
        from: certificate_address,
        ref: certificate_ref,
        datum_is: CertificateDatum,
        redeemer: BaseSpendRedeemer {
            params_idx: params_idx,
            wdrl_idx: wdrl_idx,
        },
    }

    input gas {
        from: Signer,
        min_amount: fees,
    }

    cardano::withdrawal {
        from: PlbGlobal,
        amount: 0,
        redeemer: ProgrammableLogicGlobalRedeemer::TransferAct {},
    }

    cardano::withdrawal {
        from: CoreTransfer,
        amount: 0,
        redeemer: CoreTransferRedeemer {
            proofs: [
                RegistryProof::TokenExists {
                    node_idx: node_idx,
                },
            ],
        },
    }

    cardano::withdrawal {
        from: TransferLogic,
        amount: 0,
        redeemer: TransferAction::Move {},
    }

    output certificate_out {
        to: certificate_address,
        amount: certificate_in,
        datum: CertificateDatum {
            start: certificate_in.start,
            commit: payout_credential,
            cnt_policy: certificate_in.cnt_policy,
        },
    }

    output {
        to: Signer,
        amount: gas - fees,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: plb_script,
    }
}

// ---------------------------------------------------------------- coupon claim

// Owner-signed coupon claim (§4.5): the certificate advances one step
// (`k -> k+1`), preserving the datum and the owner, and the step's coupon is
// minted under the vault's coupon policy. Withdraw-0s: the transfer chain plus
// ours (`Advance`) and the core issuance proof. The owner signs.
tx claim_owner(
    /// The certificate UTxO's PLB-custodied address.
    certificate_address: Address,
    /// The certificate UTxO being advanced.
    certificate_ref: UtxoRef,
    /// The spent (current) step name.
    old_name: Bytes,
    /// The minted (next) step name.
    new_name: Bytes,
    /// The coupon asset name (decimal lovelace bytes of the step amount).
    coupon_name: Bytes,
    /// Where the coupon is delivered (usually the holder).
    coupon_address: Address,
    /// The PLB input's `params_idx` (locates the protocol-params reference).
    params_idx: Int,
    /// The instrument's RegistryNode among the reference inputs (core
    /// registry-proof index).
    node_idx: Int,
    /// The chain's index in the canonical sorted withdrawal set (09 §10).
    wdrl_idx: Int,
    /// The instrument's RegistryNode UTxO (reference input).
    node_ref: UtxoRef,
    /// Slot of the validity lower bound; must reach `start + k * interval`.
    since_slot: Int,
) {
    reference protocol_params {
        ref: protocol_params_ref,
    }

    reference registry_node {
        ref: node_ref,
    }

    input certificate_in {
        from: certificate_address,
        ref: certificate_ref,
        datum_is: CertificateDatum,
        redeemer: BaseSpendRedeemer {
            params_idx: params_idx,
            wdrl_idx: wdrl_idx,
        },
    }

    input gas {
        from: Signer,
        min_amount: Ada(2000000) + fees,
    }

    mint {
        amount: AnyAsset(cip_policy, old_name, -1) +
            AnyAsset(cip_policy, new_name, 1),
        redeemer: IssuanceMintRedeemer {
            params_idx: params_idx,
        },
    }

    mint {
        amount: AnyAsset(coupon_policy, coupon_name, 1),
        redeemer: (),
    }

    cardano::withdrawal {
        from: PlbGlobal,
        amount: 0,
        redeemer: ProgrammableLogicGlobalRedeemer::TransferAct {},
    }

    cardano::withdrawal {
        from: CoreTransfer,
        amount: 0,
        redeemer: CoreTransferRedeemer {
            proofs: [
                RegistryProof::TokenExists {
                    node_idx: node_idx,
                },
            ],
        },
    }

    cardano::withdrawal {
        from: TransferLogic,
        amount: 0,
        redeemer: TransferAction::Move {},
    }

    cardano::withdrawal {
        from: IssuanceScript,
        amount: 0,
        redeemer: MintingAction::Advance {},
    }

    cardano::withdrawal {
        from: CoreIssuanceLogic,
        amount: 0,
        redeemer: {
            cip_policy: MintingRegistryProof::RefInput {
                index: node_idx,
            },
        },
    }

    output certificate_out {
        to: certificate_address,
        amount: certificate_in - AnyAsset(cip_policy, old_name, 1) +
            AnyAsset(cip_policy, new_name, 1),
        datum: CertificateDatum {
            start: certificate_in.start,
            commit: certificate_in.commit,
            cnt_policy: certificate_in.cnt_policy,
        },
    }

    output coupon_out {
        to: coupon_address,
        amount: AnyAsset(coupon_policy, coupon_name, 1) + Ada(2000000),
    }

    output {
        to: Signer,
        amount: gas - Ada(2000000) - fees,
    }

    validity {
        since_slot: since_slot,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: cip_policy_script,
    }

    cardano::plutus_witness {
        version: 3,
        script: coupon_script,
    }

    cardano::plutus_witness {
        version: 3,
        script: plb_script,
    }
}

// Issuer-triggered coupon claim (§4.5): the third-party chain advances the
// certificate — same transition and coupon presence as `claim_owner`, but
// permissionless on the holder side: it only works for certificates whose datum
// commits a payment credential, and the coupon minted is bound to it. The
// paired continuation is the first output (`outputs_start_idx` 0). The issuer
// signs.
tx claim_issuer(
    /// The certificate UTxO's PLB-custodied address.
    certificate_address: Address,
    /// The certificate UTxO being advanced (must commit a payout credential).
    certificate_ref: UtxoRef,
    /// The spent (current) step name.
    old_name: Bytes,
    /// The minted (next) step name.
    new_name: Bytes,
    /// The coupon asset name (decimal lovelace bytes of the step amount).
    coupon_name: Bytes,
    /// The committed payout address (its payment credential is `commit`).
    pay_address: Address,
    /// The PLB input's `params_idx` (locates the protocol-params reference).
    params_idx: Int,
    /// The instrument's RegistryNode among the reference inputs (core
    /// registry-proof index).
    node_idx: Int,
    /// The chain's index in the canonical sorted withdrawal set (09 §10).
    wdrl_idx: Int,
    /// The instrument's RegistryNode UTxO (reference input).
    node_ref: UtxoRef,
    /// Slot of the validity lower bound; must reach `start + k * interval`.
    since_slot: Int,
) {
    reference protocol_params {
        ref: protocol_params_ref,
    }

    reference registry_node {
        ref: node_ref,
    }

    input certificate_in {
        from: certificate_address,
        ref: certificate_ref,
        datum_is: CertificateDatum,
        redeemer: BaseSpendRedeemer {
            params_idx: params_idx,
            wdrl_idx: wdrl_idx,
        },
    }

    input gas {
        from: Signer,
        min_amount: Ada(2000000) + fees,
    }

    mint {
        amount: AnyAsset(cip_policy, old_name, -1) +
            AnyAsset(cip_policy, new_name, 1),
        redeemer: IssuanceMintRedeemer {
            params_idx: params_idx,
        },
    }

    mint {
        amount: AnyAsset(coupon_policy, coupon_name, 1),
        redeemer: (),
    }

    cardano::withdrawal {
        from: PlbGlobal,
        amount: 0,
        redeemer: ProgrammableLogicGlobalRedeemer::ThirdPartyAct {},
    }

    cardano::withdrawal {
        from: CoreThirdParty,
        amount: 0,
        redeemer: CoreThirdPartyRedeemer {
            registry_node_idx: node_idx,
            outputs_start_idx: 0,
        },
    }

    cardano::withdrawal {
        from: ThirdPartyLogic,
        amount: 0,
        redeemer: ThirdPartyAction::Trigger {},
    }

    cardano::withdrawal {
        from: IssuanceScript,
        amount: 0,
        redeemer: MintingAction::Advance {},
    }

    cardano::withdrawal {
        from: CoreIssuanceLogic,
        amount: 0,
        redeemer: {
            cip_policy: MintingRegistryProof::RefInput {
                index: node_idx,
            },
        },
    }

    output certificate_out {
        to: certificate_address,
        amount: certificate_in - AnyAsset(cip_policy, old_name, 1) +
            AnyAsset(cip_policy, new_name, 1),
        datum: CertificateDatum {
            start: certificate_in.start,
            commit: certificate_in.commit,
            cnt_policy: certificate_in.cnt_policy,
        },
    }

    output coupon_out {
        to: pay_address,
        amount: AnyAsset(coupon_policy, coupon_name, 1) + Ada(2000000),
    }

    output {
        to: Signer,
        amount: gas - Ada(2000000) - fees,
    }

    validity {
        since_slot: since_slot,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: cip_policy_script,
    }

    cardano::plutus_witness {
        version: 3,
        script: coupon_script,
    }

    cardano::plutus_witness {
        version: 3,
        script: plb_script,
    }
}

// ---------------------------------------------------------------- redemption

// Burn-to-pay redemption (§4.6): the coupon UTxO is spent and burned, and the
// vault pays out exactly the value its names decode to. The redeemer names the
// payout; the payout output carries at least the named amount (`payout_lovelace`
// is the output's lovelace, so a small coupon can still meet the ledger's
// min-ADA), and the vault loses exactly `payout_amount`. The redeeming holder
// signs (the coupon UTxO is the signer's input).
tx redeem(
    /// The coupon UTxO being burned (the signer's input).
    coupon_ref: UtxoRef,
    /// The coupon asset name (decimal lovelace bytes).
    coupon_name: Bytes,
    /// The coupon quantity being burned.
    coupon_quantity: Int,
    /// The vault's script address.
    vault_address: Address,
    /// The vault UTxO being spent; it continues with `- payout_amount`.
    vault_ref: UtxoRef,
    /// The vault's datum (the continuation preserves it byte-for-byte).
    vault_datum: VaultDatum,
    /// The payout destination's output address.
    payout_address: Address,
    /// The payout destination's address in its Aiken **data** form: the
    /// `Address` primitive serializes as raw bytes, which a validator decoding
    /// `Address` from data cannot read (see `AddrData`).
    payout_address_data: AddrData,
    /// The declared payout value (must equal the burned value).
    payout_amount: Int,
    /// Lovelace attached to the payout output (>= `payout_amount`).
    payout_lovelace: Int,
) {
    input coupon_in {
        from: Signer,
        ref: coupon_ref,
    }

    input vault_in {
        from: vault_address,
        ref: vault_ref,
        datum_is: VaultDatum,
        redeemer: VaultAction::Redeem {
            payouts: [
                Payout {
                    address: payout_address_data,
                    amount: payout_amount,
                },
            ],
        },
    }

    input gas {
        from: Signer,
        min_amount: Ada(2000000) + fees,
    }

    burn {
        amount: AnyAsset(coupon_policy, coupon_name, coupon_quantity),
        redeemer: (),
    }

    output payout_out {
        to: payout_address,
        amount: Ada(payout_lovelace),
    }

    output vault_out {
        to: vault_address,
        amount: vault_in - Ada(payout_amount),
        datum: vault_datum,
    }

    output {
        to: Signer,
        amount: coupon_in -
            AnyAsset(coupon_policy, coupon_name, coupon_quantity) + gas -
            Ada(payout_lovelace) + Ada(payout_amount) - fees,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: coupon_script,
    }

    cardano::plutus_witness {
        version: 3,
        script: vault_script,
    }
}

// ---------------------------------------------------------------- graduation

// Retirement, owner path (§4.7): the certificate is burned at its current
// (final) name with no continuation, and the principal coupon is minted under
// the vault's coupon policy. Withdraw-0s: the transfer chain plus ours
// (`Retire`) and the core issuance proof. The owner signs, which names and
// authorizes the payout destination.
tx graduate_owner(
    /// The certificate UTxO's PLB-custodied address.
    certificate_address: Address,
    /// The certificate UTxO whose final name burns.
    certificate_ref: UtxoRef,
    /// The burned (final) step name.
    final_name: Bytes,
    /// The principal coupon asset name (decimal lovelace bytes of `principal`).
    principal_coupon_name: Bytes,
    /// Where the principal coupon is delivered.
    coupon_address: Address,
    /// The PLB input's `params_idx` (locates the protocol-params reference).
    params_idx: Int,
    /// The instrument's RegistryNode among the reference inputs (core
    /// registry-proof index).
    node_idx: Int,
    /// The chain's index in the canonical sorted withdrawal set (09 §10).
    wdrl_idx: Int,
    /// The instrument's RegistryNode UTxO (reference input).
    node_ref: UtxoRef,
    /// Slot of the validity lower bound; must reach `start + N * interval`.
    since_slot: Int,
) {
    reference protocol_params {
        ref: protocol_params_ref,
    }

    reference registry_node {
        ref: node_ref,
    }

    input certificate_in {
        from: certificate_address,
        ref: certificate_ref,
        datum_is: CertificateDatum,
        redeemer: BaseSpendRedeemer {
            params_idx: params_idx,
            wdrl_idx: wdrl_idx,
        },
    }

    input gas {
        from: Signer,
        min_amount: Ada(2000000) + fees,
    }

    burn {
        amount: AnyAsset(cip_policy, final_name, 1),
        redeemer: IssuanceMintRedeemer {
            params_idx: params_idx,
        },
    }

    mint {
        amount: AnyAsset(coupon_policy, principal_coupon_name, 1),
        redeemer: (),
    }

    cardano::withdrawal {
        from: PlbGlobal,
        amount: 0,
        redeemer: ProgrammableLogicGlobalRedeemer::TransferAct {},
    }

    cardano::withdrawal {
        from: CoreTransfer,
        amount: 0,
        redeemer: CoreTransferRedeemer {
            proofs: [
                RegistryProof::TokenExists {
                    node_idx: node_idx,
                },
            ],
        },
    }

    cardano::withdrawal {
        from: TransferLogic,
        amount: 0,
        redeemer: TransferAction::Move {},
    }

    cardano::withdrawal {
        from: IssuanceScript,
        amount: 0,
        redeemer: MintingAction::Retire {},
    }

    cardano::withdrawal {
        from: CoreIssuanceLogic,
        amount: 0,
        redeemer: {
            cip_policy: MintingRegistryProof::RefInput {
                index: node_idx,
            },
        },
    }

    output coupon_out {
        to: coupon_address,
        amount: AnyAsset(coupon_policy, principal_coupon_name, 1) +
            Ada(2000000),
    }

    output {
        to: Signer,
        amount: certificate_in - AnyAsset(cip_policy, final_name, 1) -
            Ada(2000000) + gas - fees,
    }

    validity {
        since_slot: since_slot,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: cip_policy_script,
    }

    cardano::plutus_witness {
        version: 3,
        script: coupon_script,
    }

    cardano::plutus_witness {
        version: 3,
        script: plb_script,
    }
}

// Retirement, issuer path (§4.7): the permissionless arm — the third-party
// chain retires the certificate (no continuation) and delivers the principal
// coupon to the committed payout credential. The paired output is a certificate-
// less shell that preserves the spent UTxO's address and datum byte-for-byte
// and keeps its lovelace, so the issuer can trigger but never redirect; the
// shell is reclaimable by the owner via a transfer-path spend. The issuer
// signs.
tx graduate_issuer(
    /// The certificate UTxO's PLB-custodied address; also the shell's address.
    certificate_address: Address,
    /// The certificate UTxO being retired (must commit a payout credential).
    certificate_ref: UtxoRef,
    /// The burned (final) step name.
    final_name: Bytes,
    /// The principal coupon asset name (decimal lovelace bytes of `principal`).
    principal_coupon_name: Bytes,
    /// The committed payout address (its payment credential is `commit`).
    pay_address: Address,
    /// The PLB input's `params_idx` (locates the protocol-params reference).
    params_idx: Int,
    /// The instrument's RegistryNode among the reference inputs (core
    /// registry-proof index).
    node_idx: Int,
    /// The chain's index in the canonical sorted withdrawal set (09 §10).
    wdrl_idx: Int,
    /// The instrument's RegistryNode UTxO (reference input).
    node_ref: UtxoRef,
    /// Slot of the validity lower bound; must reach `start + N * interval`.
    since_slot: Int,
) {
    reference protocol_params {
        ref: protocol_params_ref,
    }

    reference registry_node {
        ref: node_ref,
    }

    input certificate_in {
        from: certificate_address,
        ref: certificate_ref,
        datum_is: CertificateDatum,
        redeemer: BaseSpendRedeemer {
            params_idx: params_idx,
            wdrl_idx: wdrl_idx,
        },
    }

    input gas {
        from: Signer,
        min_amount: Ada(2000000) + fees,
    }

    burn {
        amount: AnyAsset(cip_policy, final_name, 1),
        redeemer: IssuanceMintRedeemer {
            params_idx: params_idx,
        },
    }

    mint {
        amount: AnyAsset(coupon_policy, principal_coupon_name, 1),
        redeemer: (),
    }

    cardano::withdrawal {
        from: PlbGlobal,
        amount: 0,
        redeemer: ProgrammableLogicGlobalRedeemer::ThirdPartyAct {},
    }

    cardano::withdrawal {
        from: CoreThirdParty,
        amount: 0,
        redeemer: CoreThirdPartyRedeemer {
            registry_node_idx: node_idx,
            outputs_start_idx: 0,
        },
    }

    cardano::withdrawal {
        from: ThirdPartyLogic,
        amount: 0,
        redeemer: ThirdPartyAction::Trigger {},
    }

    cardano::withdrawal {
        from: IssuanceScript,
        amount: 0,
        redeemer: MintingAction::Retire {},
    }

    cardano::withdrawal {
        from: CoreIssuanceLogic,
        amount: 0,
        redeemer: {
            cip_policy: MintingRegistryProof::RefInput {
                index: node_idx,
            },
        },
    }

    output shell_out {
        to: certificate_address,
        amount: certificate_in - AnyAsset(cip_policy, final_name, 1),
        datum: CertificateDatum {
            start: certificate_in.start,
            commit: certificate_in.commit,
            cnt_policy: certificate_in.cnt_policy,
        },
    }

    output coupon_out {
        to: pay_address,
        amount: AnyAsset(coupon_policy, principal_coupon_name, 1) +
            Ada(2000000),
    }

    output {
        to: Signer,
        amount: gas - Ada(2000000) - fees,
    }

    validity {
        since_slot: since_slot,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: cip_policy_script,
    }

    cardano::plutus_witness {
        version: 3,
        script: coupon_script,
    }

    cardano::plutus_witness {
        version: 3,
        script: plb_script,
    }
}

// ============================================================
// TEST KIT — CIP-113 core bootstrap only.
//
// Consumed exclusively by `tests/devnet.test.ts` to deploy the vendored
// CIP-113 core on a fresh trix devnet: the one-shot registry, issuance
// template, upgrade-config and protocol-params mints. Never used by the bond
// lifecycle builders. Safe to delete wholesale.
// ============================================================

/// Initialize the core registry with its origin node (one-shot).
tx core_init_registry(
    /// The one-shot UTxO the applied registry policy is parameterized with.
    registry_ref: UtxoRef,
    /// The registry script address (payment = registry node policy).
    node_address: Address,
    /// The origin node datum: empty key, sentinel next, empty logic fields.
    node_datum: RegistryNode,
) {
    input registry_seed {
        from: Signer,
        ref: registry_ref,
        min_amount: Ada(2000000) + fees,
    }

    mint {
        amount: AnyAsset(node_policy, "", 1),
        redeemer: RegistryRedeemer::RegistryInit {},
    }

    output origin_node {
        to: node_address,
        amount: AnyAsset(node_policy, "", 1) + Ada(2000000),
        datum: node_datum,
    }

    output {
        to: Signer,
        amount: registry_seed - Ada(2000000) - fees,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: node_policy_script,
    }
}

/// Mint the one-shot issuance-template reference NFT, locked at the
/// always-fail address with the `IssuanceCborHex` datum.
tx core_init_cbor_hex(
    /// The one-shot UTxO the applied `issuance_cbor_hex_mint` is
    /// parameterized with.
    cbor_ref: UtxoRef,
    /// The always-fail script address the template NFT is locked at.
    lock_address: Address,
    /// The template split: prefix and postfix around the minting-logic hash.
    cbor_datum: IssuanceCborHex,
) {
    input cbor_seed {
        from: Signer,
        ref: cbor_ref,
        min_amount: Ada(2000000) + fees,
    }

    mint {
        amount: AnyAsset(cbor_hex_policy, "IssuanceCborHex", 1),
        redeemer: (),
    }

    output cbor_out {
        to: lock_address,
        amount: AnyAsset(cbor_hex_policy, "IssuanceCborHex", 1) + Ada(2000000),
        datum: cbor_datum,
    }

    output {
        to: Signer,
        amount: cbor_seed - Ada(2000000) - fees,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: cbor_hex_script,
    }
}

/// Mint the one-shot upgrade-multisig config NFT holding the approval tree.
tx core_init_upgrade_config(
    /// The one-shot UTxO the applied `upgrade_multisig` is parameterized with.
    config_ref: UtxoRef,
    /// The upgrade-multisig script address the config UTxO is locked at.
    config_address: Address,
    /// The approval tree (a single-signature tree in the test bootstrap).
    config_datum: UpgradeMultisigDatum,
) {
    input config_seed {
        from: Signer,
        ref: config_ref,
        min_amount: Ada(2000000) + fees,
    }

    mint {
        amount: AnyAsset(upgrade_multisig_policy, "UpgradeMultisig", 1),
        redeemer: (),
    }

    output config_out {
        to: config_address,
        amount: AnyAsset(upgrade_multisig_policy, "UpgradeMultisig", 1) +
            Ada(2000000),
        datum: config_datum,
    }

    output {
        to: Signer,
        amount: config_seed - Ada(2000000) - fees,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: upgrade_multisig_script,
    }
}

/// Mint the one-shot protocol-params NFT with the live wiring datum. The
/// sitting upgrade authority's withdraw-0 authorises the genesis.
tx core_init_protocol_params(
    /// The one-shot UTxO the applied `protocol_params` is parameterized with.
    params_ref: UtxoRef,
    /// The upgrade-multisig config UTxO (reference input for its withdraw-0).
    config_ref: UtxoRef,
    /// The protocol-params script address the NFT is locked at.
    params_address: Address,
    /// The live wiring: the five credentials and an empty nomination.
    params_datum: ProtocolParamsDatum,
) {
    input params_seed {
        from: Signer,
        ref: params_ref,
        min_amount: Ada(2000000) + fees,
    }

    reference upgrade_config {
        ref: config_ref,
    }

    mint {
        amount: AnyAsset(params_policy, "ProtocolParams", 1),
        redeemer: (),
    }

    cardano::withdrawal {
        from: UpgradeMultisig,
        amount: 0,
        redeemer: (),
    }

    output params_out {
        to: params_address,
        amount: AnyAsset(params_policy, "ProtocolParams", 1) + Ada(2000000),
        datum: params_datum,
    }

    output {
        to: Signer,
        amount: params_seed - Ada(2000000) - fees,
    }

    collateral {
        from: Signer,
        min_amount: fees,
    }

    signers {
        Signer,
    }

    cardano::plutus_witness {
        version: 3,
        script: params_script,
    }
}
