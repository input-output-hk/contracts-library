{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@contracts-library/meshjs": ["../lib/src/index.ts"],
      "@contracts-library/meshjs/*": ["../lib/src/*"],
      "@meshsdk/core": ["./node_modules/@meshsdk/core"],
      "@meshsdk/core/*": ["./node_modules/@meshsdk/core/*"]
    },
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "test"]
}
