{
  "name": "@contracts-library/meshjs-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end tests for the contracts-library MeshJS SDK against a Yaci DevKit devnet",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "pretest": "npm --prefix ../lib run build",
    "test": "vitest run",
    "test:devnet": "bash scripts/devnet-test.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@contracts-library/meshjs": "file:../lib",
    "@meshsdk/core": "^1.9.1",
    "@meshsdk/core-cst": "^1.9.1"
  },
  "devDependencies": {
    "@bloxbean/yaci-devkit": "0.10.6",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
