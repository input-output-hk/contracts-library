theorem dropSigner_spend :
    Formal.Properties.Universal.UP012.statement validScriptContext (accepts ledgerFuel) (rejects ledgerFuel) spend := by
  unfold Formal.Properties.Universal.UP012.statement
  blaster

theorem dropSigner_spend_applies :
