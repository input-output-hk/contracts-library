private def checksTemplate : String := r#"-- Generated by Candidates.UP012; do not edit this generated output.
-- Original source: process_blueprint.py, PR #55 at f5cbda7df624f2496dd2e6fe354a0cd15365b923, blueprint entry `linear_vesting.linear_vesting` (Aiken v1.1.22+39d6b04).
