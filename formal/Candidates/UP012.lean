private def statement (name : String) : String :=
  let body := (checksTemplate.splitOn s!"theorem {name} :")[1]?.getD ""
  ((body.splitOn ":= by").head?.getD "").trim

private def render (source modulePrefix : String) : String :=
  source.replace "Formal.Vesting.Linear.Blueprint" modulePrefix

/-- Render the original four candidate propositions in the caller's namespace. -/
def checks (modulePrefix : String) : GeneratedModule :=
  { name := s!"{modulePrefix}.Checks", source := render checksTemplate modulePrefix }

/-- Describe the original property and applicability jobs without changing their expectations. -/
def jobs (modulePrefix : String) : Array CheckJob :=
  names.map fun name =>
    let moduleName := s!"{modulePrefix}.Checks"
    let job : CheckJob :=
      { propertyId := "UP-012", name, moduleName,
        statement := statement name, expected := .valid, scope }
    match name with
    | "dropSigner_claim" =>
      { job with
        role := .property
        txModelId := some claimModelId
        applicability := some { moduleName, name := "dropSigner_claim_applies" } }
    | "dropSigner_cancel" =>
      { job with
        role := .property
        txModelId := some cancelModelId
        applicability := some { moduleName, name := "dropSigner_cancel_applies" } }
    | "dropSigner_claim_applies" =>
      { job with role := .applicability, applicability := none, txModelId := some claimModelId }
    | "dropSigner_cancel_applies" =>
      { job with role := .applicability, applicability := none, txModelId := some cancelModelId }
    | _ => job

/-- The property and applicability obligations for one registered action model. -/
def jobsForModel (selectedModelId modulePrefix : String) : Except Error (Array CheckJob) := do
  unless modelIds.contains selectedModelId do
    throw ⟨.unsupported, s!"UP-012 has no registered model {selectedModelId}"⟩
  if selectedModelId == spendModelId then
    let moduleName := s!"{modulePrefix}.Checks"
    let makeJob := fun (name : String) (role : JobRole) =>
      let body := (vaultChecksTemplate.splitOn s!"theorem {name} :")[1]?.getD ""
      let statement := ((body.splitOn ":= by").head?.getD "").trim
      { propertyId := "UP-012", name, moduleName, statement, expected := .valid,
        scope := vaultScope, role, txModelId := some spendModelId,
        applicability := if role == .property then
          some { moduleName, name := "dropSigner_spend_applies" } else none : CheckJob }
    return #[makeJob "dropSigner_spend" .property, makeJob "dropSigner_spend_applies" .applicability]
  return (jobs modulePrefix).filter (·.txModelId == some selectedModelId)

/-- Generate only the selected action's declarations, using the same shared goals. -/
def checksForModel (selectedModelId modulePrefix : String) : Except Error GeneratedModule := do
  let selectedJobs ← jobsForModel selectedModelId modulePrefix
  if selectedModelId == spendModelId then
    return { name := s!"{modulePrefix}.Checks", source := render vaultChecksTemplate modulePrefix }
  let header := ((checksTemplate.splitOn "/--").head?.getD "")
  let declarations := selectedJobs.map fun job =>
    let definition := if job.role == .applicability then "applicability" else "statement"
    s!"theorem {job.name} :\n{job.statement} := by\n" ++
      s!"  unfold Formal.Properties.Universal.UP012.{definition}\n  blaster\n"
  return {
    name := s!"{modulePrefix}.Checks"
    source := render header modulePrefix ++
      String.intercalate "\n" declarations.toList ++ s!"\nend {modulePrefix}\n" }

def notes : Array String :=
  #[scope, "Each action's applicability obligation qualifies only its linked property obligation; all jobs retain their declared Valid expectation."]

/-- Scope notes for the selected action model. -/
def notesForModel (selectedModelId : String) : Array String :=
  if selectedModelId == spendModelId then
    #[vaultScope, "Applicability qualifies only the linked spend property obligation; both jobs retain their declared Valid expectation."]
  else notes

end Candidates.UP012
