private def scope : String :=
  "Experimental pinned linear-vesting Claim profile only: TxM-007 has two outputs, one signer, " ++
  "and one vested asset. Reverse the outputs; preserve validScriptContext premises and the " ++
  "1,000,000-step acceptance bound. Applicability separately requires an actual output-list change."

private def claimModelId : String := Formal.TxModels.TxM007.metadata.id

def modelIds : Array String := #[claimModelId]

private def statement (name : String) : String :=
  let body := (checksTemplate.splitOn s!"theorem {name} :")[1]?.getD ""
  ((body.splitOn ":= by").head?.getD "").trim

/-- Render the Claim property and its applicability goal in the caller's namespace. -/
def checks (modulePrefix : String) : GeneratedModule :=
  { name := s!"{modulePrefix}.Checks"
    source := checksTemplate.replace "Formal.Vesting.Linear.Blueprint" modulePrefix }

/-- Link the property to the applicability goal for the single registered Claim model. -/
def jobs (modulePrefix : String) : Array CheckJob :=
  let moduleName := s!"{modulePrefix}.Checks"
  #[
    { propertyId := "UP-015", name := "reverseOutputs_claim", moduleName
      statement := statement "reverseOutputs_claim", expected := .valid, scope
      role := .property, txModelId := some claimModelId
      applicability := some { moduleName, name := "reverseOutputs_claim_applies" } },
    { propertyId := "UP-015", name := "reverseOutputs_claim_applies", moduleName
      statement := statement "reverseOutputs_claim_applies", expected := .valid, scope
      role := .applicability, txModelId := some claimModelId } ]

def notes : Array String :=
  #[scope, "The Claim applicability goal qualifies only its linked property goal; both retain their declared Valid expectation."]

