import Workflow.Generator.Basic
import Formal.Universal.Properties
import Formal.Properties.Universal.UP001.Definition

namespace Candidates.UP001

open Workflow Workflow.Generator

private def allPurposes : Array Purpose :=
  #[.spend, .mint, .withdraw, .publish, .vote, .propose]

private def contextType : Purpose → String
  | .spend => "EverySpend"
  | .mint => "EveryMint"
  | .withdraw => "EveryWithdraw"
  | .publish => "EveryPublish"
  | .vote => "EveryVote"
  | .propose => "EveryPropose"

private def modelId : Purpose → String
  | .mint => Formal.TxModels.TxM001.metadata.id
  | .withdraw => Formal.TxModels.TxM002.metadata.id
  | .publish => Formal.TxModels.TxM003.metadata.id
  | .vote => Formal.TxModels.TxM004.metadata.id
  | .propose => Formal.TxModels.TxM005.metadata.id
  | .spend => Formal.TxModels.TxM006.metadata.id

def modelIds : Array String := allPurposes.map modelId

private def scope : String :=
  "No acceptance within 5,000,000 CEK steps for undeclared purposes. " ++
  "Fuel exhaustion satisfies the claim; it does not establish explicit rejection."

private def typesSource (target : TargetDescription) (modulePrefix : String) : String :=
  String.intercalate "\n" [
    "-- Generated by Candidates.UP001; do not edit this generated output.",
    "import PlutusCore.UPLC", "import CardanoLedgerApi", "", s!"namespace {modulePrefix}", "",
    "open PlutusCore.UPLC.Term (Term Const Program)",
    "open PlutusCore.UPLC.CekMachine (cekExecuteProgram State)",
    "open CardanoLedgerApi.IsData.Class (toTerm)",
    "open CardanoLedgerApi.V3 (ScriptContext)", "",
    s!"def program : Program := singleCborEncodedScriptFromHexM {reprStr target.compiledCode}", "",
    "def args (ctx : ScriptContext) : List Term := [toTerm ctx]", "",
    "def accepts (fuel : Nat) (ctx : ScriptContext) : Prop :=",
    "  cekExecuteProgram program (args ctx) fuel = .Halt (.VCon Const.Unit)", "",
    s!"end {modulePrefix}", ""]

private def checksHeader (modulePrefix : String) : String :=
  String.intercalate "\n" [
    "-- UP-001 domains and predicate from candidate PR #49 at b44b6b0757a75d79b79a4de4712523ee3978760e.",
    "-- Reviewed workflow bound: 5,000,000 CEK steps (candidate: 1,000,000).",
    "import Blaster", "import Formal.Universal.Properties", "import Formal.Properties.Universal.UP001.Definition", s!"import {modulePrefix}.Types", "",
    "set_option Elab.async false", "", s!"namespace {modulePrefix}", "",
    "open PlutusCore.Data (Data)", "open Formal.Universal.Properties", "",
    "/-! UP-001: no success within 5,000,000 CEK steps for undeclared purposes.",
    "The full TxInfo, redeemer, and purpose fields are variables.",
    "Fuel exhaustion satisfies this claim; it does not establish an explicit error.",
    "-/", ""]

/-- The bounded nonacceptance proposition for one undeclared purpose. -/
def statement (purpose : Purpose) : String :=
  let ctx := contextType purpose
  s!"    Formal.Properties.Universal.UP001.statement (accepts 5000000) {ctx}.ctx"

private def makeJob (modulePrefix : String) (purpose : Purpose) : CheckJob :=
  { propertyId := "UP-001"
    name := s!"otherPurpose_{purpose.name}"
    moduleName := s!"{modulePrefix}.Checks"
    statement := statement purpose
    expected := .valid
    txModelId := some (modelId purpose)
    scope }

private def buildSelected (target : TargetDescription) (modulePrefix : String)
    (selected : Option Purpose) : Except Error GenerationPlan := do
  unless target.plutusVersion == "v3" do
    throw ⟨.unsupported, "UP-001 generation currently supports Plutus V3 only"⟩
  unless (target.parameters.getD #[]).isEmpty do
    throw ⟨.unsupported,
      "parameterized UP-001 generation requires the candidate's typed parameter translation"⟩
  let requested := selected.map (fun purpose => #[purpose]) |>.getD allPurposes
  let undeclared := requested.filter fun p => !target.declaredPurposes.contains p
  if undeclared.isEmpty then
    let reason := match selected with
      | none => "All purposes have handlers; UP-001 has no obligations."
      | some purpose => s!"The selected {purpose.name} purpose has a declared handler; UP-001 has no obligation for this model."
    return { targetName := target.name, modules := #[], jobs := #[],
             notes := #[reason] }
  let jobs := undeclared.map (makeJob modulePrefix)
  let declarations := jobs.map fun job =>
    s!"theorem {job.name} :\n{job.statement} := by\n  unfold Formal.Properties.Universal.UP001.statement\n  blaster\n"
  let checks := checksHeader modulePrefix ++ "\n" ++
    String.intercalate "\n" declarations.toList ++ s!"\nend {modulePrefix}\n"
  return {
    targetName := target.name
    modules := #[⟨s!"{modulePrefix}.Types", typesSource target modulePrefix⟩,
                 ⟨s!"{modulePrefix}.Checks", checks⟩]
    jobs
    notes := #[scope] }

/-- Reuse the candidate's domains and predicate with the reviewed 5,000,000-step bound. -/
def provider : Provider := { id := "UP-001", generate := fun target modulePrefix => buildSelected target modulePrefix none }

/-- Select one code-owned purpose model before generating its obligation. -/
def providerForModel (selectedModelId : String) : Except Error Provider := do
  let some purpose := allPurposes.find? (fun purpose => modelId purpose == selectedModelId)
    | throw ⟨.unsupported, s!"UP-001 has no registered model {selectedModelId}"⟩
  return { id := "UP-001", generate := fun target modulePrefix => buildSelected target modulePrefix (some purpose) }

end Candidates.UP001
