/-- Match the authored inputs, frozen bytes, and program to the tracked blueprint. -/
def checkSource : IO Unit := do
  let source ← IO.FS.readFile "Formal/Properties/Universal/UP011/Tests/Standalone/Project/validators/ignore_address.ak"
  unless source == validatorSource do
    throw (IO.userError "UP011 authored control source changed; rebuild and review the fixture")
  let manifest ← IO.FS.readFile "Formal/Properties/Universal/UP011/Tests/Standalone/Project/aiken.toml"
  let lock ← IO.FS.readFile "Formal/Properties/Universal/UP011/Tests/Standalone/Project/aiken.lock"
  unless manifest == projectManifest && lock == dependencyLock do
    throw (IO.userError "UP011 compiler or dependency inputs changed; rebuild and review the fixture")
  let blueprint ← IO.ofExcept (Lean.Json.parse
    (← IO.FS.readFile "Formal/Properties/Universal/UP011/Tests/Standalone/Inputs/control.json"))
  let preamble ← IO.ofExcept (blueprint.getObjVal? "preamble")
  let version ← IO.ofExcept (preamble.getObjValAs? String "plutusVersion")
  let compiler ← IO.ofExcept (preamble.getObjVal? "compiler")
  let compilerVersion ← IO.ofExcept (compiler.getObjValAs? String "version")
  unless version == "v3" && compilerVersion == "v1.1.21+42babe5" do
    throw (IO.userError "UP011 control requires Plutus V3 and Aiken v1.1.21+42babe5")
  let entries ← IO.ofExcept do (← blueprint.getObjVal? "validators").getArr?
  let titles ← entries.mapM fun entry => IO.ofExcept (entry.getObjValAs? String "title")
  unless entries.size == 2 && titles.contains "ignore_address.ignore_address.spend" &&
      titles.contains "ignore_address.ignore_address.else" do
    throw (IO.userError "UP011 control handler declarations changed")
  for entry in entries do
    let code ← IO.ofExcept (entry.getObjValAs? String "compiledCode")
    let hash ← IO.ofExcept (entry.getObjValAs? String "hash")
    unless code == compiledCode && hash == scriptHashHex do
      throw (IO.userError "UP011 control differs from the tracked source artifact")
    let decoded ← IO.ofExcept
      (PlutusCore.UPLC.ScriptEncoding.Internal.singleCborEncodedScriptFromHex? code)
    unless reprStr decoded == reprStr program do
      throw (IO.userError "UP011 control program differs from its frozen bytes")
    if let .ok parameters := entry.getObjVal? "parameters" then
      let parameters ← IO.ofExcept parameters.getArr?
      unless parameters.isEmpty do
        throw (IO.userError "UP011 control must remain unparameterized")
  IO.println "UP011 control matches the tracked unparameterized V3 source fixture."

end Tests.UP011.Fixture
