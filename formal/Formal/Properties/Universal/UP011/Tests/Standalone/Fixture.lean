/-!
Deliberately faulty, unparameterized Plutus V3 spending validator. Built from
Project/validators/ignore_address.ak with Aiken v1.1.21+42babe5 and stdlib v3.0.0.
It requires an inline datum on the first output and ignores that output's address.
The single-CBOR program below is frozen; checkSource binds it to the tracked
Inputs/control.json blueprint, authored source, manifest, and dependency lock.
-/

/-- Exact authored source corresponding to the frozen program. -/
def validatorSource : String := "use cardano/transaction.{InlineDatum, OutputReference, Transaction}\n\n// Deliberate bug: the first output must carry an inline datum, but its address\n// is unchecked. Redirection removes that datum; a payment-credential change does not.\nvalidator ignore_address {\n  spend(\n    _datum: Option<Data>,\n    _redeemer: Data,\n    _own_ref: OutputReference,\n    self: Transaction,\n  ) {\n    expect [first, ..] = self.outputs\n    expect InlineDatum(_) = first.datum\n    True\n  }\n\n  else(_) {\n    fail\n  }\n}\n"

/-- Recorded compiler and dependency requirements for the authored fixture. -/
def projectManifest : String := "name = \"no-witness-labs/up011-negative-control\"\nversion = \"0.0.0\"\ncompiler = \"v1.1.21\"\nplutus = \"v3\"\nlicense = \"Apache-2.0\"\ndescription = \"UP-011 control that requires a continuation datum but ignores its address\"\n\n[[dependencies]]\nname = \"aiken-lang/stdlib\"\nversion = \"v3.0.0\"\nsource = \"github\"\n"

