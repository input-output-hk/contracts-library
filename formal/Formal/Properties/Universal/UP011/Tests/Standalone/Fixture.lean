def program : Program := singleCborEncodedScriptFromHexM "588201010029800aba2aba1aab9eaab9dab9a4888896600264646644b30013370e900118031baa0018994c004c024006601260140032300a300b300b00148896600266e1d2004300a3754600260166ea8c030dd6180098059baa300c0088a518b201218039baa0018b200a30060013006300700130060013003375400d149a26cac80081"

