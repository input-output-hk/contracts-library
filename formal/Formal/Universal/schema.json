{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "category", "summary", "theorems"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string" },
      "title": { "type": "string" },
      "category": { "enum": ["universal"] },
      "summary": { "type": "string" },
      "theorems": { "type": "array", "items": { "type": "string" } }
    }
  }
}
