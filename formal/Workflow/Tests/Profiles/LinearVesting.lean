import Formal.TxModels.Artifacts.LinearVesting
import Workflow.Generator.Basic
import Formal.TxModels.Definitions.TxM007
import Formal.TxModels.Definitions.TxM008

namespace Workflow.Tests.Profiles.LinearVesting

open Workflow Workflow.Generator

/-! Shared test preparation for two known linear-vesting artifacts: the PR #55 fixture at
f5cbda7df624f2496dd2e6fe354a0cd15365b923 and the Aiken 1.1.21/stdlib 3.0.0 vault-demo build.
Native types and models live in Formal.TxModels.
-/

private abbrev referenceCompiledCode := Formal.TxModels.Artifacts.LinearVesting.referenceCompiledCode

private abbrev aiken1121CompiledCode := Formal.TxModels.Artifacts.LinearVesting.aiken1121CompiledCode

private def knownArtifact (compiledCode : String) : Option (String × String) :=
  if compiledCode == referenceCompiledCode then
    some ("95da21788eb1f59f51aad9669eb8c8b7081ab618c1f29b871925894a",
      "PR #55 pinned artifact (Aiken v1.1.22+39d6b04)")
  else if compiledCode == aiken1121CompiledCode then
    some ("114e35c85d59745cb61ba73e1a9192467a4dae666a286a45f97a15f8",
      "vault-demo artifact (Aiken v1.1.21+42babe5, stdlib v3.0.0)")
  else none

private def typesTemplate : String := r#"-- Generated by Workflow.Tests.Profiles.LinearVesting; do not edit this generated output.
-- Template source: process_blueprint.py, PR #55 at f5cbda7df624f2496dd2e6fe354a0cd15365b923, blueprint entry `linear_vesting.linear_vesting`.
-- Accepted artifact: __ARTIFACT_LABEL__.
import PlutusCore.UPLC
import CardanoLedgerApi
import Formal.Support.Compatibility
import Formal.TxModels.VestingTypes

namespace Formal.Vesting.Linear.Blueprint

open PlutusCore.Data (Data)
open PlutusCore.ByteString (ByteString)
open PlutusCore.UPLC.Term (Term Const Program)
open PlutusCore.UPLC.CekMachine (cekExecuteProgram State)
open CardanoLedgerApi.IsData.Class (IsData toTerm)
open CardanoLedgerApi.V3 (Address Credential StakingCredential ScriptContext TxOutRef)

/-! ## Types -/

abbrev Vesting.Types.VestedAsset := Formal.TxModels.Vesting.Types.VestedAsset
abbrev Vesting.Types.VestingDatum := Formal.TxModels.Vesting.Types.VestingDatum
abbrev Vesting.Types.VestingRedeemer := Formal.TxModels.Vesting.Types.VestingRedeemer

/-! ## Handlers -/

/-- Purposes with a handler in the blueprint (the `else` fallback is not listed). -/
def handlers : List String := ["spend"]

abbrev SpendDatum := Vesting.Types.VestingDatum
abbrev SpendRedeemer := Vesting.Types.VestingRedeemer

/-! ## Parameters and script -/

/-- The script's arguments: the script context only (no parameters). -/
def args (ctx : ScriptContext) : List Term := [toTerm ctx]

def program : Program := singleCborEncodedScriptFromHexM __COMPILED_CODE__

/-- The known hash for the accepted compiled artifact (hex). -/
def scriptHashHex : String := __SCRIPT_HASH__

/-- The script accepts within `fuel` steps. -/
def accepts (fuel : Nat) (ctx : ScriptContext) : Prop :=
  cekExecuteProgram program (args ctx) fuel = .Halt (.VCon Const.Unit)

/-- The script genuinely fails within `fuel` steps (running out of steps is not a failure). -/
def rejects (fuel : Nat) (ctx : ScriptContext) : Prop :=
  Formal.Support.rejectedWithin program (args ctx) fuel

end Formal.Vesting.Linear.Blueprint
"#

private def txTemplate : String := r#"-- Generated by Workflow.Tests.Profiles.LinearVesting; do not edit this generated output.
-- The native model definitions and metadata live in Formal/TxModels/Definitions/TxM007.lean and TxM008.lean.
import Formal.TxModels.Definitions.TxM007
import Formal.TxModels.Definitions.TxM008
import Formal.Vesting.Linear.Blueprint.Types

namespace Formal.Vesting.Linear.Blueprint

abbrev vestedPolicy := Formal.TxModels.Vesting.vestedPolicy
abbrev vestingDatum := Formal.TxModels.Vesting.vestingDatum
abbrev ClaimLeaves := Formal.TxModels.TxM007.ClaimLeaves
abbrev claim := Formal.TxModels.TxM007.claim
abbrev CancelLeaves := Formal.TxModels.TxM008.CancelLeaves
abbrev cancel := Formal.TxModels.TxM008.cancel

end Formal.Vesting.Linear.Blueprint
"#

private def render (source modulePrefix : String) : String :=
  source.replace "Formal.Vesting.Linear.Blueprint" modulePrefix

private def txForModel (selectedModelId modulePrefix : String) : Except Error String := do
  let (moduleName, leaves, action) ←
    if selectedModelId == Formal.TxModels.TxM007.metadata.id then
      pure ("TxM007", "ClaimLeaves", "claim")
    else if selectedModelId == Formal.TxModels.TxM008.metadata.id then
      pure ("TxM008", "CancelLeaves", "cancel")
    else throw ⟨.unsupported, s!"linear-vesting profile has no registered model {selectedModelId}"⟩
  return String.intercalate "\n" [
    "-- Generated by Workflow.Tests.Profiles.LinearVesting; do not edit this generated output.",
    s!"import Formal.TxModels.Definitions.{moduleName}", s!"import {modulePrefix}.Types", "",
    s!"namespace {modulePrefix}", "",
    "abbrev vestedPolicy := Formal.TxModels.Vesting.vestedPolicy",
    "abbrev vestingDatum := Formal.TxModels.Vesting.vestingDatum",
    s!"abbrev {leaves} := Formal.TxModels.{moduleName}.{leaves}",
    s!"abbrev {action} := Formal.TxModels.{moduleName}.{action}", "",
    s!"end {modulePrefix}", ""]

/-- Prepare a known artifact and native transaction aliases for a test profile. -/
def support (target : TargetDescription) (modulePrefix : String)
    (selectedModelId : Option String) : Except Error (Array GeneratedModule) := do
  let unsupported : Error := ⟨.unsupported,
    "test profile supports only the original unparameterized linear-vesting artifact from PR #55 or the known Aiken 1.1.21/stdlib 3.0.0 artifact"⟩
  unless target.plutusVersion == "v3" && (target.parameters.getD #[]).isEmpty &&
      target.declaredPurposes == #[.spend] do
    throw unsupported
  let some (scriptHash, artifactLabel) := knownArtifact target.compiledCode
    | throw unsupported
  let tx ← match selectedModelId with
    | none => pure (render txTemplate modulePrefix)
    | some modelId => txForModel modelId modulePrefix
  let types := typesTemplate.replace "__COMPILED_CODE__" (reprStr target.compiledCode)
  let types := types.replace "__SCRIPT_HASH__" (reprStr scriptHash)
  let types := types.replace "__ARTIFACT_LABEL__" artifactLabel
  return #[
    ⟨s!"{modulePrefix}.Types", render types modulePrefix⟩,
    ⟨s!"{modulePrefix}.Tx", tx⟩]

end Workflow.Tests.Profiles.LinearVesting
