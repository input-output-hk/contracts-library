import Workflow.Types.Target
import Workflow.Types.Jobs
import PlutusCore.UPLC.ScriptEncoding.Basic
import Cryptograph.Blake2b

namespace Workflow.Preparation.Program

private def scriptBytes (code : String) : Except String (List UInt8) := do
  let some bytes := PlutusCore.UPLC.ScriptEncoding.Internal.hexStringToString code.data []
    | throw "could not decode hexadecimal compiled code"
  let some (remaining, _) := PlutusCore.Cbor.decodeLargeBytestring ⟨bytes⟩
    | throw "could not decode single-CBOR compiled code"
  unless remaining.isEmpty do
    throw "unexpected bytes after the compiled script"
  let _ ← PlutusCore.UPLC.ScriptEncoding.Internal.singleCborEncodedScriptFromHex? code
  return bytes.map Char.toUInt8

private def hexByte (byte : UInt8) : String :=
  let digits := "0123456789abcdef".data.toArray
  String.mk [digits[byte.toNat / 16]!, digits[byte.toNat % 16]!]

/-- Cardano V3 hashes the language tag followed by the single-CBOR script bytes. -/
def scriptHashHex (compiledCode : String) : Except String String := do
  let bytes ← scriptBytes compiledCode
  return String.join ((Cryptograph.Blake2b.blake2b_224 (3 :: bytes)).map hexByte)

private def template : String := r#"-- Generated by Workflow.Preparation.Program.
import PlutusCore.UPLC
import CardanoLedgerApi
import Formal.Support.Execution

namespace __NAMESPACE__

open PlutusCore.Data (Data)
open PlutusCore.ByteString (ByteString)
open PlutusCore.UPLC.Term (Term Const Program)
open PlutusCore.UPLC.CekMachine (cekExecuteProgram State)
open CardanoLedgerApi.IsData.Class (IsData toTerm)
open CardanoLedgerApi.V3 (Address Credential StakingCredential ScriptContext TxOutRef)

/-- The unparameterized V3 script receives its script context. -/
def args (ctx : ScriptContext) : List Term := [toTerm ctx]

def program : Program := singleCborEncodedScriptFromHexM __COMPILED_CODE__

/-- Hash computed from the supplied script bytes. -/
def scriptHashHex : String := __SCRIPT_HASH__

/-- The script returns unit within the supplied step bound. -/
def accepts (fuel : Nat) (ctx : ScriptContext) : Prop :=
  cekExecuteProgram program (args ctx) fuel = .Halt (.VCon Const.Unit)

/-- A step-limit exhaustion does not count as rejection. -/
def rejects (fuel : Nat) (ctx : ScriptContext) : Prop :=
  Formal.Support.rejectedWithin program (args ctx) fuel

end __NAMESPACE__
"#

/-- Prepare the actual unparameterized V3 program independently of its metadata. -/
def support (target : TargetDescription) (modulePrefix : String) :
    Except String GeneratedModule := do
  unless validModuleName modulePrefix do
    throw "module prefix must contain capitalized Lean identifier segments"
  unless target.plutusVersion == "v3" && (target.parameters.getD #[]).isEmpty do
    throw "program preparation requires an unparameterized Plutus V3 script"
  let code := target.compiledCode.toLower
  let hash ← scriptHashHex code
  let source := template.replace "__NAMESPACE__" modulePrefix
    |>.replace "__COMPILED_CODE__" (reprStr code)
    |>.replace "__SCRIPT_HASH__" (reprStr hash)
  return ⟨s!"{modulePrefix}.Types", source⟩

end Workflow.Preparation.Program
