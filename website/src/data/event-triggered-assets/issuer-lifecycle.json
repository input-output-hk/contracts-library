{
  "name": "eta-issuer-lifecycle",
  "title": "Issuer-triggered lifecycle",
  "transactions": [
    {
      "block": "Deposit",
      "name": "deposit",
      "title": "Deposit (unit)",
      "inputs": [
        {
          "name": "Depositor funds",
          "address": "depositor_addr",
          "value": {
            "ADA": "principal + min_ada",
            "FeeAsset": "f"
          }
        },
        {
          "name": "Vault",
          "address": "vault_addr",
          "redeemer": "VaultDeposit",
          "value": {
            "ADA": "funds",
            "vaultNFT": "1"
          },
          "datum": {
            "cnt_policy": "coupon policy id"
          }
        },
        {
          "name": "Protocol params",
          "address": "protocol_params",
          "reference": true
        },
        {
          "name": "RegistryNode",
          "address": "registry_addr",
          "reference": true,
          "value": {
            "registryNode": "1"
          }
        }
      ],
      "mint": [{ "token": "cipNFT (step 0)", "amount": "1" }],
      "withdrawals": [
        "minting_logic (ours) [Deposit]",
        "issuance_logic (core) [names policy + RegistryNode]"
      ],
      "signatures": ["depositor"],
      "outputs": [
        {
          "name": "Vault",
          "address": "vault_addr",
          "value": {
            "ADA": "funds + principal",
            "vaultNFT": "1"
          },
          "datum": {
            "cnt_policy": "coupon policy id"
          }
        },
        {
          "id": "cert-v0",
          "name": "Certificate",
          "address": "plb_addr [stake: depositor]",
          "value": {
            "cipNFT (step 0)": "1"
          },
          "datum": {
            "start": "upper (finite)",
            "commit": "None",
            "cnt_policy": "vault's"
          }
        }
      ]
    },
    {
      "block": "Authorize",
      "name": "authorize",
      "title": "Authorize (self-transfer)",
      "inputs": [
        {
          "id": "cert-v0",
          "name": "Certificate",
          "redeemer": "BaseSpendRedeemer"
        },
        {
          "name": "Protocol params",
          "address": "protocol_params",
          "reference": true
        },
        {
          "name": "RegistryNode",
          "address": "registry_addr",
          "reference": true,
          "value": {
            "registryNode": "1"
          }
        }
      ],
      "withdrawals": [
        "programmable_logic_global [TransferAct]",
        "transfer [TransferRedeemer]",
        "transfer_logic (ours)"
      ],
      "signatures": ["owner"],
      "outputs": [
        {
          "id": "cert-v1",
          "name": "Certificate",
          "address": "plb_addr [stake: owner]",
          "value": {
            "cipNFT (step 0)": "1"
          },
          "datum": {
            "start": "…",
            "commit": "Some(pay)",
            "cnt_policy": "…"
          }
        }
      ]
    },
    {
      "block": "Issuer claim 1",
      "name": "issuer-claim-1",
      "title": "Issuer claim (step 1)",
      "inputs": [
        {
          "id": "cert-v1",
          "name": "Certificate",
          "redeemer": "BaseSpendRedeemer"
        },
        {
          "name": "Protocol params",
          "address": "protocol_params",
          "reference": true
        },
        {
          "name": "RegistryNode",
          "address": "registry_addr",
          "reference": true,
          "value": {
            "registryNode": "1"
          }
        }
      ],
      "mint": [
        { "token": "cipNFT (step 0)", "amount": "-1" },
        { "token": "cipNFT (step 1)", "amount": "1" },
        { "token": "coupon (amount_1)", "amount": "1" }
      ],
      "withdrawals": [
        "programmable_logic_global [ThirdPartyAct]",
        "third_party [ThirdPartyRedeemer]",
        "third_party_logic (ours)",
        "minting_logic (ours) [Advance]",
        "issuance_logic (core) [names policy + RegistryNode]"
      ],
      "signatures": ["issuer"],
      "outputs": [
        {
          "id": "cert-v2",
          "name": "Certificate",
          "address": "plb_addr [stake: owner]",
          "value": {
            "cipNFT (step 1)": "1"
          },
          "datum": {
            "start": "…",
            "commit": "Some(pay)",
            "cnt_policy": "…"
          }
        },
        {
          "name": "Coupon",
          "address": "pay_addr [payment: pay]",
          "value": {
            "coupon (amount_1)": "1"
          }
        }
      ],
      "validRange": {
        "lower": "start + 1 * interval"
      }
    },
    {
      "block": "Issuer claim k",
      "name": "issuer-claim-k",
      "title": "Issuer claim (step k)",
      "inputs": [
        {
          "id": "cert-v2",
          "name": "Certificate",
          "redeemer": "BaseSpendRedeemer"
        },
        {
          "name": "Protocol params",
          "address": "protocol_params",
          "reference": true
        },
        {
          "name": "RegistryNode",
          "address": "registry_addr",
          "reference": true,
          "value": {
            "registryNode": "1"
          }
        }
      ],
      "mint": [
        { "token": "cipNFT (step 1)", "amount": "-1" },
        { "token": "cipNFT (step k)", "amount": "1" },
        { "token": "coupon (amount_k)", "amount": "1" }
      ],
      "withdrawals": [
        "programmable_logic_global [ThirdPartyAct]",
        "third_party [ThirdPartyRedeemer]",
        "third_party_logic (ours)",
        "minting_logic (ours) [Advance]",
        "issuance_logic (core) [names policy + RegistryNode]"
      ],
      "signatures": ["issuer"],
      "outputs": [
        {
          "id": "cert-v3",
          "name": "Certificate",
          "address": "plb_addr [stake: owner]",
          "value": {
            "cipNFT (step k)": "1"
          },
          "datum": {
            "start": "…",
            "commit": "Some(pay)",
            "cnt_policy": "…"
          }
        },
        {
          "name": "Coupon",
          "address": "pay_addr [payment: pay]",
          "value": {
            "coupon (amount_k)": "1"
          }
        }
      ],
      "validRange": {
        "lower": "start + k * interval"
      }
    },
    {
      "block": "Issuer claim N",
      "name": "issuer-claim-n",
      "title": "Issuer claim (step N)",
      "inputs": [
        {
          "id": "cert-v3",
          "name": "Certificate",
          "redeemer": "BaseSpendRedeemer"
        },
        {
          "name": "Protocol params",
          "address": "protocol_params",
          "reference": true
        },
        {
          "name": "RegistryNode",
          "address": "registry_addr",
          "reference": true,
          "value": {
            "registryNode": "1"
          }
        }
      ],
      "mint": [
        { "token": "cipNFT (step k)", "amount": "-1" },
        { "token": "cipNFT (step N)", "amount": "1" },
        { "token": "coupon (amount_N)", "amount": "1" }
      ],
      "withdrawals": [
        "programmable_logic_global [ThirdPartyAct]",
        "third_party [ThirdPartyRedeemer]",
        "third_party_logic (ours)",
        "minting_logic (ours) [Advance]",
        "issuance_logic (core) [names policy + RegistryNode]"
      ],
      "signatures": ["issuer"],
      "outputs": [
        {
          "id": "cert-v4",
          "name": "Certificate",
          "address": "plb_addr [stake: owner]",
          "value": {
            "cipNFT (step N)": "1"
          },
          "datum": {
            "start": "…",
            "commit": "Some(pay)",
            "cnt_policy": "…"
          }
        },
        {
          "name": "Coupon",
          "address": "pay_addr [payment: pay]",
          "value": {
            "coupon (amount_N)": "1"
          }
        }
      ],
      "validRange": {
        "lower": "start + N * interval"
      }
    },
    {
      "block": "Issuer graduation",
      "name": "issuer-graduation",
      "title": "Issuer graduation",
      "inputs": [
        {
          "id": "cert-v4",
          "name": "Certificate",
          "redeemer": "BaseSpendRedeemer"
        },
        {
          "name": "Protocol params",
          "address": "protocol_params",
          "reference": true
        },
        {
          "name": "RegistryNode",
          "address": "registry_addr",
          "reference": true,
          "value": {
            "registryNode": "1"
          }
        }
      ],
      "mint": [
        { "token": "cipNFT (step N)", "amount": "-1" },
        { "token": "coupon (principal)", "amount": "1" }
      ],
      "withdrawals": [
        "programmable_logic_global [ThirdPartyAct]",
        "third_party [ThirdPartyRedeemer]",
        "third_party_logic (ours)",
        "minting_logic (ours) [Retire]",
        "issuance_logic (core) [names policy + RegistryNode]"
      ],
      "signatures": ["issuer"],
      "outputs": [
        {
          "name": "Ghost continuation",
          "address": "plb_addr [stake: owner]",
          "value": {
            "ADA": "min_ada"
          },
          "datum": {
            "start": "…",
            "commit": "Some(pay)",
            "cnt_policy": "…"
          }
        },
        {
          "name": "Principal coupon",
          "address": "pay_addr [payment: pay]",
          "value": {
            "coupon (principal)": "1"
          }
        }
      ],
      "validRange": {
        "lower": "start + N * interval"
      }
    }
  ],
  "notes": "The owner opts in with Authorize, committing a payment credential. The issuer then triggers every coupon claim and graduation, always paying the commitment. The owner can revoke at any time and always keeps the holder path. Register is a one-time prerequisite above."
}
